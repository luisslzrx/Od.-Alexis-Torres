---

---

<section
  id="contacto"
  class="relative w-full overflow-hidden bg-slate-50 pt-20 md:pt-28 scroll-mt-24"
>
  <div class="mx-auto max-w-7xl px-6 md:px-14">
    <!-- Top: headline + newsletter -->
    <div
      class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between"
    >
      <div>
        <a href="#inicio" class="inline-flex items-center gap-2.5 mb-6 group">
          <img
            src="/logo.png"
            alt="Logo Od. Alexis Torres"
            class="h-9 w-9 object-contain transition-transform group-hover:scale-105"
          />
          <span class="text-2xl font-bold tracking-tight text-slate-900"
            >Od. Alexis Torres</span
          >
        </a>
        <h2
          class="text-4xl font-semibold leading-[1.2] text-slate-900 md:text-5xl"
        >
          Tu sonrisa nos importa<br />Contáctanos hoy mismo
        </h2>
      </div>

      <div class="w-full max-w-md">
        <p class="text-slate-600">
          Únete a nuestro boletín para recibir consejos de salud bucal,
          promociones exclusivas y novedades de nuestro consultorio.
        </p>

        <form
          class="mt-5 flex items-center gap-2 rounded-full bg-white p-1.5 pl-5 shadow-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-5 w-5 shrink-0 text-slate-400"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <input
            type="email"
            placeholder="Tu correo electrónico"
            class="w-full bg-transparent text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full bg-[#0D214B] px-6 py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.02] active:scale-95 hover:bg-[#1a3875]"
          >
            Suscribirme
          </button>
        </form>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-16 border-t border-slate-200"></div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p
          class="text-xs font-semibold tracking-wider text-slate-400 uppercase"
        >
          Clínica
        </p>
        <ul class="mt-5 space-y-4 text-slate-800">
          <li>
            <a href="#inicio" class="hover:text-[#4E8C41] transition-colors"
              >Inicio</a>
          </li>
          <li>
            <a href="#servicios" class="hover:text-[#4E8C41] transition-colors"
              >Servicios</a>
          </li>
          <li>
            <a href="#nosotros" class="hover:text-[#4E8C41] transition-colors"
              >Sobre nosotros</a>
          </li>
          <li>
            <a href="#doctor" class="hover:text-[#4E8C41] transition-colors"
              >Especialista</a>
          </li>
        </ul>
      </div>

      <div>
        <p
          class="text-xs font-semibold tracking-wider text-slate-400 uppercase"
        >
          Recursos
        </p>
        <ul class="mt-5 space-y-4 text-slate-800">
          <li>
            <a
              href="https://wa.me/522223085239?text=Hola,%20me%20gustar%C3%ADa%20agendar%20una%20cita."
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#4E8C41] transition-colors inline-flex items-center gap-1.5"
            >
              Agendar cita
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3 text-slate-400">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="/#beneficios" class="hover:text-[#4E8C41] transition-colors"
              >Beneficios</a
            >
          </li>
          <li>
            <a href="/blog" class="hover:text-[#4E8C41] transition-colors"
              >Blog y consejos</a
            >
          </li>
          <li>
            <a
              href="/#testimonios"
              class="hover:text-[#4E8C41] transition-colors">Testimonios</a
            >
          </li>
        </ul>
      </div>

      <div>
        <p
          class="text-xs font-semibold tracking-wider text-slate-400 uppercase"
        >
          Legal
        </p>
        <ul class="mt-5 space-y-4 text-slate-800">
          <li>
            <a
              href="/politica-de-privacidad"
              class="hover:text-[#4E8C41] transition-colors"
              >Aviso de Privacidad y Cookies</a
            >
          </li>
          <li>
            <a
              href="/politica-de-privacidad"
              class="hover:text-[#4E8C41] transition-colors"
              >Términos y Condiciones</a
            >
          </li>
          <li>
            <a
              href="/politica-de-privacidad"
              class="hover:text-[#4E8C41] transition-colors"
              >Consentimiento Informado</a
            >
          </li>
        </ul>
      </div>

      <div>
        <p
          class="text-xs font-semibold tracking-wider text-slate-400 uppercase"
        >
          Atención y Contacto
        </p>
        <div class="mt-4 space-y-0.5">
          <p class="text-base font-semibold text-slate-900">Alexis Torres</p>
          <p
            class="text-xs font-medium uppercase tracking-wider text-[#4E8C41]"
          >
            Odontólogo
          </p>
        </div>
        <a
          href="mailto:cd.alexisto@gmail.com"
          class="mt-3 block text-base font-medium text-slate-900 hover:text-[#4E8C41] transition-colors"
        >
          cd.alexisto@gmail.com
        </a>
        <a
          href="tel:+522223085239"
          class="mt-1.5 block text-base font-semibold text-slate-900 hover:text-[#4E8C41] transition-colors"
        >
          222-308-52-39
        </a>
        <p class="mt-1.5 text-sm text-slate-500">
          Xicoténcatl 35, Int. 1, Col. Centro, Xalapa, Ver.
        </p>

        <p class="mt-8 text-sm font-semibold text-slate-800">
          Síguenos en Instagram
        </p>
        <div class="mt-3">
          <a
            href="https://www.instagram.com/od.alexistorres"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2.5 rounded-full border border-slate-300 bg-white py-2 pl-3 pr-4 text-sm font-medium text-slate-800 shadow-xs transition-all hover:border-pink-300 hover:text-pink-700 hover:shadow-sm active:scale-95"
          >
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 text-white shadow-xs">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-3.5 w-3.5"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </span>
            <span>@od.alexistorres</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Giant watermark wordmark -->
  <div class="pointer-events-none select-none overflow-hidden">
    <p
      class="-mb-8 whitespace-nowrap text-center font-semibold leading-none text-slate-900/[0.06]"
      style="font-size: 13vw;"
    >
      Alexis Torres
    </p>
  </div>

  <!-- Bottom bar -->
  <div class="relative border-t border-slate-200 px-6 py-6 md:px-14">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center gap-3 text-sm text-slate-500 sm:flex-row sm:justify-between"
    >
      <span>© 2026 Alexis Torres · Todos los derechos reservados</span>
      <div class="flex items-center gap-6">
        <a
          href="/politica-de-privacidad"
          class="hover:text-[#4E8C41] transition-colors"
          >Términos y Condiciones</a
        >
        <a
          href="/politica-de-privacidad"
          class="hover:text-[#4E8C41] transition-colors"
          >Política de Privacidad y Cookies</a
        >
      </div>
    </div>
  </div>
</section>
