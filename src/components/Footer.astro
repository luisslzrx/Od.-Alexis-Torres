---

---

<section id="contacto" class="relative w-full overflow-hidden bg-slate-50 pt-20 md:pt-28 scroll-mt-24">
  <div class="mx-auto max-w-7xl px-6 md:px-14">
    <!-- Top: headline + newsletter -->
    <div
      class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between"
    >
      <div>
        <a href="#inicio" class="inline-flex items-center gap-2.5 mb-6 group">
          <img
            src="/logo.png"
            alt="Logo Od. Alexis Torres"
            class="h-9 w-9 object-contain transition-transform group-hover:scale-105"
          />
          <span class="text-2xl font-bold tracking-tight text-slate-900">Od. Alexis Torres</span>
        </a>
        <h2
          class="text-4xl font-semibold leading-[1.2] text-slate-900 md:text-5xl"
        >
          Tu sonrisa nos importa<br />Contáctanos hoy mismo
        </h2>
      </div>

      <div class="w-full max-w-md">
        <p class="text-slate-600">
          Únete a nuestro boletín para recibir consejos de salud bucal, promociones exclusivas y novedades de nuestro consultorio.
        </p>

        <form
          class="mt-5 flex items-center gap-2 rounded-full bg-white p-1.5 pl-5 shadow-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-5 w-5 shrink-0 text-slate-400"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          <input
            type="email"
            placeholder="Tu correo electrónico"
            class="w-full bg-transparent text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full bg-[#0D214B] px-6 py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.02] active:scale-95 hover:bg-[#1a3875]"
          >
            Suscribirme
          </button>
        </form>
      </div>
    </div>

    <!-- Divider -->
    <div class="mt-16 border-t border-slate-200"></div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">Clínica</p>
        <ul class="mt-5 space-y-4 text-slate-800">
          <li><a href="#inicio" class="hover:text-[#4E8C41] transition-colors">Inicio</a></li>
          <li><a href="#servicios" class="hover:text-[#4E8C41] transition-colors">Servicios</a></li>
          <li><a href="#nosotros" class="hover:text-[#4E8C41] transition-colors">Sobre nosotros</a></li>
          <li><a href="#doctor" class="hover:text-[#4E8C41] transition-colors">Especialista</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">
          Recursos
        </p>
        <ul class="mt-5 space-y-4 text-slate-800">
          <li><a href="#formulario" class="hover:text-[#4E8C41] transition-colors">Agendar cita</a></li>
          <li><a href="#beneficios" class="hover:text-[#4E8C41] transition-colors">Beneficios</a></li>
          <li><a href="#blog" class="hover:text-[#4E8C41] transition-colors">Blog y consejos</a></li>
          <li><a href="#testimonios" class="hover:text-[#4E8C41] transition-colors">Testimonios</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">Legal</p>
        <ul class="mt-5 space-y-4 text-slate-800">
          <li><a href="/politica-de-privacidad" class="hover:text-[#4E8C41] transition-colors">Aviso de Privacidad y Cookies</a></li>
          <li>
            <a href="/politica-de-privacidad" class="hover:text-[#4E8C41] transition-colors">Términos y Condiciones</a>
          </li>
          <li><a href="/politica-de-privacidad" class="hover:text-[#4E8C41] transition-colors">Transparencia y Uso de IA</a></li>
          <li><a href="/politica-de-privacidad" class="hover:text-[#4E8C41] transition-colors">Consentimiento Informado</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">
          Atención y Contacto
        </p>
        <div class="mt-4 space-y-0.5">
          <p class="text-base font-semibold text-slate-900">Alexis Torres</p>
          <p class="text-xs font-medium uppercase tracking-wider text-[#4E8C41]">Odontólogo</p>
        </div>
        <a
          href="mailto:cd.alexisto@gmail.com"
          class="mt-3 block text-base font-medium text-slate-900 hover:text-[#4E8C41] transition-colors"
        >
          cd.alexisto@gmail.com
        </a>
        <a
          href="tel:+522223085239"
          class="mt-1.5 block text-base font-semibold text-slate-900 hover:text-[#4E8C41] transition-colors"
        >
          222-308-52-39
        </a>
        <p class="mt-1.5 text-sm text-slate-500">
          Xalapa, Ver.
        </p>

        <p class="mt-8 text-sm font-semibold text-slate-800">Síguenos en redes</p>
        <div class="mt-3 flex items-center gap-3">
          <a
            href="#"
            aria-label="Facebook"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 text-slate-800 hover:bg-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-4 w-4"
            >
              <path
                d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            aria-label="Instagram"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 text-slate-800 hover:bg-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-4 w-4"
            >
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="3.5"></circle>
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"
              ></circle>
            </svg>
          </a>
          <a
            href="#"
            aria-label="X"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 text-slate-800 hover:bg-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-4 w-4"
            >
              <path
                d="M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-6.6L4.4 22H1.3l8.1-9.3L1 2h7l4.9 6z"
              ></path>
            </svg>
          </a>
          <a
            href="#"
            aria-label="YouTube"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 text-slate-800 hover:bg-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-4 w-4"
            >
              <path
                d="M23 12s0-3.5-.45-5.14a3 3 0 00-2.1-2.1C18.8 4.3 12 4.3 12 4.3s-6.8 0-8.45.46a3 3 0 00-2.1 2.1C1 8.5 1 12 1 12s0 3.5.45 5.14a3 3 0 002.1 2.1C5.2 19.7 12 19.7 12 19.7s6.8 0 8.45-.46a3 3 0 002.1-2.1C23 15.5 23 12 23 12zM9.75 15.5v-7l6 3.5-6 3.5z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Giant watermark wordmark -->
  <div class="pointer-events-none select-none overflow-hidden">
    <p
      class="-mb-8 whitespace-nowrap text-center font-semibold leading-none text-slate-900/[0.06]"
      style="font-size: 13vw;"
    >
      Alexis Torres
    </p>
  </div>

  <!-- Bottom bar -->
  <div class="relative border-t border-slate-200 px-6 py-6 md:px-14">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center gap-3 text-sm text-slate-500 sm:flex-row sm:justify-between"
    >
      <span>© 2026 Alexis Torres · Todos los derechos reservados</span>
      <div class="flex items-center gap-6">
        <a href="/politica-de-privacidad" class="hover:text-[#4E8C41] transition-colors">Términos y Condiciones</a>
        <a href="/politica-de-privacidad" class="hover:text-[#4E8C41] transition-colors">Política de Privacidad y Cookies</a>
      </div>
    </div>
  </div>
</section>
