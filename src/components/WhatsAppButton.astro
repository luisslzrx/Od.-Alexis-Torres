---
const phoneNumber = "522223085239";
const message = "Hola, me gustaría agendar una cita.";
---

<a
  href={`https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chatear por WhatsApp"
  class="group fixed bottom-6 right-6 z-50 flex h-16 w-16 items-center justify-start overflow-hidden rounded-full bg-[#4E8C41] p-2 text-white shadow-xl shadow-[#4E8C41]/30 transition-all duration-300 hover:w-auto hover:pr-6 active:scale-95 md:bottom-8 md:right-8"
>
  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-[#4E8C41] shadow-xs">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 004.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.19c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.11.11-1.79-.11-.41-.13-.94-.3-1.62-.6-2.84-1.23-4.7-4.1-4.84-4.29-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.09.99-2.37.26-.28.57-.35.76-.35.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.57.81 1.98.88 2.12.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.71 1.17 1.52 1.9 1.05.94 1.93 1.23 2.21 1.37.28.14.44.12.61-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.63-.14.26.09 1.65.78 1.93.92.28.14.47.21.54.33.07.13.07.71-.17 1.39z" />
    </svg>
  </span>
  <span class="max-w-0 overflow-hidden whitespace-nowrap text-sm font-semibold opacity-0 transition-all duration-300 group-hover:max-w-xs group-hover:ml-3 group-hover:opacity-100">
    Chatea con nosotros
  </span>
</a>
