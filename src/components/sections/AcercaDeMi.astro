---

---

<section
  id="nosotros"
  class="w-full bg-white px-4 sm:px-6 md:px-14 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24"
>
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Columna izquierda: Badge, Titular, Subtítulo y Métricas -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <!-- Badge -->
        <span
          class="inline-block w-fit rounded-full border border-slate-300 px-4 py-1.5 sm:px-6 sm:py-2 text-xs sm:text-sm font-semibold text-slate-700 uppercase tracking-wider mb-4 sm:mb-6"
        >
          Sobre nosotros
        </span>

        <!-- Titular principal -->
        <h2
          class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight sm:leading-[1.18] text-slate-900 tracking-tight"
        >
          Ofrecemos atención dental personalizada con tecnología moderna y un
          trato cercano para lograr sonrisas sanas y llenas de confianza.
        </h2>

        <!-- Sonrisas que hablan por nosotros + Métricas -->
        <div class="mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-slate-100">
          <p class="text-xs sm:text-sm font-semibold text-[#4E8C41] uppercase tracking-wider mb-4 sm:mb-6">
            Sonrisas que hablan por nosotros
          </p>

          <div class="grid grid-cols-3 gap-3 sm:gap-8">
            <div>
              <p class="text-2xl sm:text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">
                98%
              </p>
              <p class="mt-1 sm:mt-2 text-xs sm:text-sm text-slate-500 leading-snug">
                Pacientes satisfechos
              </p>
            </div>
            <div>
              <p class="text-2xl sm:text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">
                2,000+
              </p>
              <p class="mt-1 sm:mt-2 text-xs sm:text-sm text-slate-500 leading-snug">
                Sonrisas atendidas
              </p>
            </div>
            <div>
              <p class="text-2xl sm:text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">
                4.9 <span class="text-[#4E8C41]">★</span>
              </p>
              <p class="mt-1 sm:mt-2 text-xs sm:text-sm text-slate-500 leading-snug">
                Calificación media
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Imagen del consultorio / tratamiento -->
      <div class="lg:col-span-5">
        <div class="relative overflow-hidden rounded-3xl shadow-sm border border-slate-100">
          <img
            src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?q=80&w=800&auto=format&fit=crop"
            alt="Paciente recibiendo tratamiento dental profesional"
            class="h-64 sm:h-80 md:h-[460px] lg:h-[500px] w-full object-cover"
          />
          <!-- Insignia flotante con efecto vidrio -->
          <div class="absolute bottom-3.5 left-3.5 right-3.5 sm:bottom-4 sm:left-4 sm:right-4 rounded-2xl bg-white/95 backdrop-blur-md p-3.5 sm:p-4 border border-white/50 shadow-md flex items-center justify-between gap-3">
            <div>
              <p class="text-xs sm:text-sm font-bold text-slate-900">Instalaciones de primer nivel</p>
              <p class="text-[11px] sm:text-xs text-slate-500">Tecnología de diagnóstico y confort</p>
            </div>
            <span class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-[#4E8C41] text-white shrink-0 shadow-xs">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
