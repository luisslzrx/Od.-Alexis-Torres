---

---

<section id="beneficios" class="w-full overflow-hidden bg-slate-50 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24">
  <!-- Header -->
  <div class="mx-auto flex flex-col sm:flex-row sm:items-end justify-between gap-5 px-4 sm:px-6 md:px-14 max-w-7xl">
    <div>
      <span class="text-xs sm:text-sm font-semibold text-[#4E8C41] uppercase tracking-wider block mb-1.5 sm:mb-2">
        Atención de Calidad
      </span>
      <h2
        class="max-w-2xl text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight sm:leading-[1.15] text-slate-900"
      >
        ¿Por qué elegir nuestro consultorio dental?
      </h2>
    </div>

    <!-- Controles de navegación del slider -->
    <div class="flex shrink-0 items-center gap-2.5 self-end sm:self-auto">
      <button
        id="beneficios-prev"
        type="button"
        aria-label="Anterior"
        class="flex h-10 w-10 sm:h-12 sm:w-12 md:h-14 md:w-14 items-center justify-center rounded-full border border-slate-300 text-slate-700 transition-colors hover:bg-slate-200 cursor-pointer active:scale-95"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="h-4 w-4 sm:h-5 sm:w-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 12H5m0 0l6-6m-6 6l6 6"></path>
        </svg>
      </button>
      <button
        id="beneficios-next"
        type="button"
        aria-label="Siguiente"
        class="flex h-10 w-10 sm:h-12 sm:w-12 md:h-14 md:w-14 items-center justify-center rounded-full bg-[#0D214B] text-white transition-all hover:scale-105 hover:bg-[#1a3875] cursor-pointer active:scale-95 shadow-sm"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="h-4 w-4 sm:h-5 sm:w-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 12h14m0 0l-6-6m6 6l-6 6"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Fila de tarjetas con scroll suave y ajuste móvil (snap-x) -->
  <div
    id="beneficios-slider"
    class="mt-8 sm:mt-12 md:mt-14 flex items-stretch gap-4 sm:gap-6 overflow-x-auto scroll-smooth px-4 sm:px-6 md:px-14 pb-4 select-none snap-x snap-mandatory"
  >
    <!-- Card 1: oral scan (Tarjeta izquierda) -->
    <div
      class="w-[82vw] max-w-[290px] sm:w-72 shrink-0 snap-start overflow-hidden rounded-3xl bg-white shadow-xs flex flex-col justify-between border border-slate-100/80"
    >
      <div class="p-5 sm:p-6 pb-0">
        <h3 class="text-lg sm:text-xl font-semibold leading-snug text-slate-900">
          Cuidado integral para tu sonrisa
        </h3>
      </div>
      <img
        src="https://images.unsplash.com/photo-1609840114035-3c981b782dfe?q=80&w=600&auto=format&fit=crop"
        alt="Revisión dental completa"
        class="mt-4 sm:mt-5 h-44 sm:h-52 w-full object-cover"
      />
    </div>

    <!-- Card 2: green card (Tarjeta verde #4E8C41) -->
    <div
      class="flex w-[85vw] max-w-[320px] sm:w-80 shrink-0 snap-start flex-col justify-between rounded-3xl bg-[#4E8C41] p-6 sm:p-7 text-white shadow-xs"
    >
      <div class="flex items-center gap-3">
        <div class="flex -space-x-2">
          <img
            src="https://images.unsplash.com/photo-1633332755192-727a05c4013d?q=80&w=100&auto=format&fit=crop"
            alt=""
            class="h-8 w-8 sm:h-9 sm:w-9 rounded-full border-2 border-[#4E8C41] object-cover"
          />
          <img
            src="https://images.unsplash.com/photo-1633332755192-727a05c4013d?q=80&w=100&auto=format&fit=crop"
            alt=""
            class="h-8 w-8 sm:h-9 sm:w-9 rounded-full border-2 border-[#4E8C41] object-cover"
          />
          <img
            src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=100&auto=format&fit=crop"
            alt=""
            class="h-8 w-8 sm:h-9 sm:w-9 rounded-full border-2 border-[#4E8C41] object-cover"
          />
        </div>
        <span class="text-xs sm:text-sm font-medium text-white/95">3.5K+ sonrisas atendidas</span>
      </div>

      <div class="mt-6 sm:mt-8">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3.5 py-1.5 text-xs sm:text-sm font-medium text-white backdrop-blur-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-3.5 w-3.5 sm:h-4 sm:w-4"
          >
            <path
              d="M5 4h14v2a5 5 0 01-4 4.9V13a3 3 0 002 2.83V18h-6v-2.17A3 3 0 0013 13v-2.1A5 5 0 019 4z"
            ></path>
          </svg>
          Beneficios
        </span>
        <p class="mt-4 sm:mt-5 text-base sm:text-xl leading-snug">
          Cuida tu sonrisa con atención preventiva y tratamientos personalizados para mantener una salud bucal óptima.
        </p>
      </div>
    </div>

    <!-- Card 3: main image -->
    <div class="w-[88vw] max-w-[480px] sm:w-[460px] lg:w-[560px] shrink-0 snap-start overflow-hidden rounded-3xl shadow-xs border border-slate-100/80">
      <img
        src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=1200&auto=format&fit=crop"
        alt="Paciente sonriendo en el consultorio dental"
        class="h-full w-full object-cover min-h-[280px] sm:min-h-[400px]"
      />
    </div>

    <!-- Card 4: stats (Tarjeta derecha) -->
    <div
      class="flex w-[82vw] max-w-[290px] sm:w-72 shrink-0 snap-start flex-col justify-between rounded-3xl bg-white p-6 sm:p-7 shadow-xs border border-slate-100/80"
    >
      <div>
        <p class="text-4xl sm:text-5xl font-bold text-slate-900">98%</p>
        <p class="mt-2 sm:mt-3 text-xs sm:text-sm font-medium leading-snug text-slate-500">
          Pacientes satisfechos con nuestros tratamientos
        </p>
      </div>

      <div class="mt-8 sm:mt-10 flex items-end justify-center gap-3 sm:gap-4">
        <div class="flex flex-col items-center gap-1.5 sm:gap-2">
          <span class="h-16 sm:h-20 w-6 sm:w-7 rounded-full bg-[#0D214B]"></span>
          <span class="text-xs font-medium text-slate-500">Mar</span>
        </div>
        <div class="flex flex-col items-center gap-1.5 sm:gap-2">
          <span class="h-22 sm:h-28 w-6 sm:w-7 rounded-full bg-[#4E8C41]"></span>
          <span class="text-xs font-medium text-slate-500">Abr</span>
        </div>
        <div class="flex flex-col items-center gap-1.5 sm:gap-2">
          <span class="h-14 sm:h-16 w-6 sm:w-7 rounded-full bg-[#0D214B]"></span>
          <span class="text-xs font-medium text-slate-500">May</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById('beneficios-slider');
  const prevBtn = document.getElementById('beneficios-prev');
  const nextBtn = document.getElementById('beneficios-next');

  function getScrollAmount() {
    return window.innerWidth < 640 ? 300 : 360;
  }

  prevBtn?.addEventListener('click', () => {
    slider?.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    slider?.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
  });
</script>
