---
const rawPosts = import.meta.glob("../../content/blog/*.md", { eager: true });
const posts = Object.entries(rawPosts).map(([path, post]: [string, any]) => {
  const slug = path.split("/").pop()?.replace(".md", "");
  return {
    slug,
    ...post.frontmatter,
  };
});
---

<section id="blog" class="w-full bg-white px-4 sm:px-6 md:px-14 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24">
  <div class="mx-auto max-w-7xl">
    <!-- Encabezado -->
    <div
      class="flex flex-col gap-4 sm:gap-6 lg:flex-row lg:items-start lg:justify-between"
    >
      <span
        class="inline-block w-fit rounded-full border border-slate-300 px-4 py-1.5 sm:px-6 sm:py-2 text-xs sm:text-sm font-semibold text-slate-700 uppercase tracking-wider"
      >
        Nuestro Blog
      </span>

      <h2
        class="max-w-2xl text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight sm:leading-[1.2] text-slate-900"
      >
        Consejos expertos para cuidar la salud, estética y bienestar de tu sonrisa.
      </h2>
    </div>

    <!-- Tarjetas de artículos (1 columna en móviles, 2 en tablets, 3 en escritorio) -->
    <div class="mt-8 sm:mt-12 md:mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {
        posts.map((post) => (
          <article class="rounded-3xl bg-slate-50 p-3 sm:p-3.5 shadow-xs hover:shadow-md transition-all border border-slate-100 flex flex-col justify-between">
            <div>
              <a href={`/blog/${post.slug}`} class="block relative overflow-hidden rounded-2xl group">
                <img
                  src={post.image}
                  alt={post.title}
                  class="h-48 sm:h-56 md:h-60 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <span class="absolute left-3.5 top-3.5 rounded-full bg-white/95 backdrop-blur-sm px-3.5 py-1 text-xs font-semibold text-slate-800 shadow-sm">
                  {post.tag}
                </span>
              </a>

              <div class="px-2 pt-4 pb-2">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2.5">
                    <img
                      src={post.avatar || "/logo.png"}
                      alt={post.author}
                      class="h-8 w-8 sm:h-9 sm:w-9 rounded-full object-contain bg-white border border-slate-200 p-0.5 shrink-0"
                    />
                    <div>
                      <p class="text-xs sm:text-sm font-semibold text-slate-900 leading-tight">
                        {post.author}
                      </p>
                      <p class="text-[11px] text-slate-500">{post.readTime}</p>
                    </div>
                  </div>
                  <span class="flex items-center gap-1 text-[11px] sm:text-xs text-slate-400 shrink-0">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400" />
                    {post.date}
                  </span>
                </div>

                <h3 class="mt-4 sm:mt-5 text-base sm:text-lg md:text-xl font-bold leading-snug text-slate-900 hover:text-[#4E8C41] transition-colors">
                  <a href={`/blog/${post.slug}`} class="line-clamp-2">
                    {post.title}
                  </a>
                </h3>

                <p class="mt-2 text-xs sm:text-sm text-slate-600 line-clamp-2 leading-relaxed">
                  {post.description}
                </p>
              </div>
            </div>

            <div class="px-2 pb-2 pt-2">
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-[#0D214B] hover:text-[#4E8C41] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-4 w-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 10l-4 4 4 4M5 14h13a4 4 0 000-8h-1"
                  />
                </svg>
                Leer artículo
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Botón inferior -->
    <div class="mt-10 sm:mt-14 flex justify-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-3 sm:gap-4 rounded-full bg-[#0D214B] py-2 sm:py-2.5 pl-6 sm:pl-7 pr-2 text-sm sm:text-base font-semibold text-white shadow-md transition-all hover:scale-[1.02] active:scale-95 hover:bg-[#1a3875]"
      >
        <span>Conoce más artículos</span>
        <span
          class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-white text-[#0D214B] shadow-xs shrink-0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="h-4 w-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
