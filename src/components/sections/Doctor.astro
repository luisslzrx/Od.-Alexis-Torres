---

---

<section
  id="doctor"
  class="w-full bg-white px-4 sm:px-6 md:px-14 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="grid grid-cols-1 gap-10 sm:gap-12 lg:grid-cols-2 lg:gap-16 items-center"
    >
      <!-- Left column -->
      <div>
        <span
          class="inline-block rounded-full border border-slate-300 px-4 py-1.5 sm:px-6 sm:py-2 text-xs sm:text-sm font-semibold text-slate-700 uppercase tracking-wider"
        >
          Tratamiento destacado
        </span>

        <h2
          class="mt-5 sm:mt-8 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight sm:leading-[1.15] text-slate-900"
        >
          Atención dental especializada para una sonrisa saludable
        </h2>

        <p
          class="mt-4 sm:mt-6 max-w-md text-sm sm:text-base leading-relaxed text-slate-600"
        >
          Recibe atención profesional y tratamientos personalizados para cuidar
          tu salud bucal y mantener una sonrisa sana y segura.
        </p>

        <!-- Doctor card + info -->
        <div
          class="mt-8 sm:mt-12 flex flex-col gap-6 sm:flex-row sm:items-start"
        >
          <!-- Video-call style card -->
          <div
            class="relative h-72 sm:h-80 w-full sm:w-72 shrink-0 overflow-hidden rounded-2xl bg-sky-100 shadow-sm max-w-xs mx-auto sm:mx-0"
          >
            <img
              src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?q=80&w=600&auto=format&fit=crop"
              alt="Odontólogo Alexis Torres"
              class="h-full w-full object-cover"
            />

            <!-- Call controls -->
            <div
              class="absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-2.5 sm:gap-3"
            >
              <button
                type="button"
                aria-label="Silenciar"
                class="flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-white/70 text-slate-700 backdrop-blur-sm shadow-sm"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-4 w-4 sm:h-5 sm:w-5"
                >
                  <path
                    d="M12 14a3 3 0 003-3V6a3 3 0 10-6 0v5a3 3 0 003 3zm5-3a5 5 0 01-10 0H5a7 7 0 006 6.92V21h2v-3.08A7 7 0 0019 11h-2z"
                  ></path>
                </svg>
              </button>
              <button
                type="button"
                aria-label="Alternar video"
                class="flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-white/70 text-slate-700 backdrop-blur-sm shadow-sm"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-4 w-4 sm:h-5 sm:w-5"
                >
                  <path
                    d="M17 10.5V7a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h12a1 1 0 001-1v-3.5l4 4v-11l-4 4z"
                  ></path>
                </svg>
              </button>
              <button
                type="button"
                aria-label="Finalizar llamada"
                class="flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-red-500 text-white shadow-sm"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-4 w-4 sm:h-5 sm:w-5 rotate-[135deg]"
                >
                  <path
                    d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.24 1.01l-2.21 2.2z"
                  ></path>
                </svg>
              </button>
            </div>
          </div>

          <!-- Doctor info -->
          <div
            class="flex flex-1 flex-col pt-1 text-center sm:text-left items-center sm:items-start"
          >
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900">
              Alexis Torres
            </h3>
            <p
              class="mt-0.5 text-xs sm:text-sm font-semibold text-[#4E8C41] uppercase tracking-wider"
            >
              Odontólogo
            </p>

            <div
              class="mt-3 flex items-center gap-1.5 text-xs sm:text-sm text-slate-700"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="#4E8C41"
                class="h-4 w-4"
              >
                <path
                  d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.7 7-6.3-3.9-6.3 3.9 1.7-7L2 9.2l7.1-.6z"
                ></path>
              </svg>
              <span class="font-bold text-slate-900">4.9 ★</span>
              <span class="text-slate-500">45+ reseñas</span>
            </div>

            <p
              class="mt-4 sm:mt-6 max-w-xs text-xs sm:text-sm leading-relaxed text-slate-600"
            >
              Atención dental personalizada para cuidar tu sonrisa con
              profesionalismo, precisión y confianza.
            </p>

            <a
              href="#contacto"
              class="mt-5 sm:mt-6 inline-flex w-full sm:w-fit items-center justify-between sm:justify-start gap-3 sm:gap-4 rounded-full bg-[#0D214B] py-2 pl-6 sm:pl-7 pr-2 text-sm font-semibold text-white shadow-sm transition-all hover:scale-[1.02] hover:bg-[#1a3875] active:scale-95"
            >
              <span>Agenda tu cita</span>
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-[#0D214B] shadow-xs shrink-0"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="h-4 w-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right column: office image + stats card -->
      <div class="relative mt-4 lg:mt-0">
        <img
          src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?q=80&w=1200&auto=format&fit=crop"
          alt="Equipo de consultorio dental"
          class="h-[360px] sm:h-[480px] lg:h-[600px] w-full rounded-3xl object-cover"
        />

        <!-- Floating stats card -->
        <div
          class="absolute inset-x-3 bottom-3 rounded-2xl bg-white/95 backdrop-blur-md p-4 sm:p-6 shadow-xl sm:inset-x-8 sm:bottom-8 sm:p-8 border border-slate-100"
        >
          <div class="grid grid-cols-2 divide-x divide-slate-200">
            <div>
              <p class="text-xs sm:text-sm leading-snug text-slate-500">
                Revisiones recomendadas<br />al año
              </p>
              <p
                class="mt-1.5 sm:mt-2 flex items-baseline gap-1.5 text-2xl sm:text-4xl font-bold text-slate-900"
              >
                2 <span class="text-xs sm:text-sm font-normal text-slate-500"
                  >visitas</span
                >
              </p>
            </div>
            <div class="pl-4 sm:pl-8">
              <p class="text-xs sm:text-sm leading-snug text-slate-500">
                Duración promedio<br />de consulta
              </p>
              <p
                class="mt-1.5 sm:mt-2 flex items-baseline gap-1.5 text-2xl sm:text-4xl font-bold text-slate-900"
              >
                40 <span class="text-xs sm:text-sm font-normal text-slate-500"
                  >min</span
                >
              </p>
            </div>
          </div>

          <div class="mt-4 sm:mt-6 border-t border-slate-200 pt-3.5 sm:pt-5">
            <div
              class="flex items-center justify-between text-xs sm:text-sm text-slate-600 font-medium"
            >
              <span>Citas de hoy</span>
              <span class="font-bold text-slate-900">60%</span>
            </div>
            <div class="mt-2.5 sm:mt-3 flex gap-1 sm:gap-1.5 justify-between">
              {
                Array.from({ length: 18 }).map((_, i) => (
                  <span
                    class={`h-6 sm:h-8 flex-1 max-w-[12px] rounded-full ${i < 11 ? "bg-[#4E8C41]" : "bg-[#4E8C41]/20"}`}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
