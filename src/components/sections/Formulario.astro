---
const services = [
  "Limpieza dental",
  "Implantes dentales",
  "Corona dental",
  "Extracciones dentales",
  "Guarda dental",
  "Resina",
];
---

<section id="contacto" class="w-full bg-slate-50 px-4 sm:px-6 md:px-14 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24">
  <div class="mx-auto max-w-7xl">
    <!-- Top: Header Container -->
    <div class="apple-reveal">
      <span
        class="inline-block w-fit rounded-full border border-slate-300 px-4 py-1.5 sm:px-6 sm:py-2 text-xs sm:text-sm font-semibold text-slate-700 uppercase tracking-wider"
      >
        Agenda tu cita
      </span>

      <h2
        class="mt-3 sm:mt-4 max-w-3xl text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight sm:leading-[1.15] text-slate-900"
      >
        Agenda tu consulta con nuestros especialistas
      </h2>

      <p class="mt-3 sm:mt-4 max-w-xl text-sm sm:text-base leading-relaxed text-slate-600">
        Elige la fecha que mejor te convenga y nuestro equipo confirmará tu
        cita a la brevedad.
      </p>
    </div>

    <!-- Divided in two: Left = Map + Card, Right = Form (Equal Heights) -->
    <div class="mt-8 sm:mt-12 md:mt-14 grid grid-cols-1 gap-8 sm:gap-10 lg:grid-cols-2 lg:gap-12 items-stretch">
      <!-- Left column: Google Map + Phone card -->
      <div class="flex flex-col gap-5 sm:gap-6 h-full apple-reveal apple-delay-1">
        <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl shadow-xs border border-slate-200/80 bg-slate-100 flex-1 min-h-[320px] sm:min-h-[380px] w-full apple-card">
          <iframe
            title="Ubicación Odontólogo Alexis Torres en Google Maps"
            src="https://maps.google.com/maps?q=Xicot%C3%A9ncatl+35%2C+Centro%2C+Xalapa%2C+Veracruz&t=&z=17&ie=UTF8&iwloc=&output=embed"
            class="h-full w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>

          <!-- Floating address badge on map -->
          <a
            href="https://www.google.com/maps/search/?api=1&query=Xicot%C3%A9ncatl+35%2C+Centro%2C+Xalapa%2C+Veracruz"
            target="_blank"
            rel="noopener noreferrer"
            class="absolute bottom-3 left-3 right-3 sm:bottom-4 sm:left-4 sm:right-4 rounded-xl bg-white/95 backdrop-blur-md px-3.5 py-2.5 sm:px-4 sm:py-3 shadow-md border border-slate-100 flex items-center justify-between gap-3 text-slate-800 hover:text-[#0D214B] transition-all hover:bg-white"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="flex h-8 w-8 sm:h-9 sm:w-9 items-center justify-center rounded-full bg-[#0D214B] text-white shrink-0 shadow-xs">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-4 w-4 sm:h-4.5 sm:w-4.5 text-white"
                >
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
              </span>
              <div class="truncate">
                <p class="text-xs sm:text-sm font-bold text-slate-900 truncate">Xicoténcatl 35, Int. 1</p>
                <p class="text-[11px] sm:text-xs text-slate-500 truncate">Col. Centro, Xalapa, Ver.</p>
              </div>
            </div>
            <span class="text-xs font-semibold text-[#4E8C41] flex items-center gap-1 shrink-0 whitespace-nowrap">
              Ver mapa
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3 w-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </span>
          </a>
        </div>

        <div class="flex items-center gap-3.5 sm:gap-4 rounded-2xl bg-white p-4 sm:p-5 shadow-xs border border-slate-100 shrink-0 apple-card">
          <span
            class="flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-full bg-[#0D214B] text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5.5A2.5 2.5 0 015.5 3H8a2 2 0 012 1.5l1 3a2 2 0 01-.5 2L9 11a12 12 0 006 6l1.5-1.5a2 2 0 012-.5l3 1a2 2 0 011.5 2v2.5A2.5 2.5 0 0120.5 22C10.85 22 3 14.15 3 4.5z"
              ></path>
            </svg>
          </span>
          <div>
            <p class="text-xs sm:text-sm text-slate-500">¿Necesitas ayuda para agendar?</p>
            <a
              href="tel:+522223085239"
              class="text-base sm:text-lg font-bold text-slate-900 hover:text-[#4E8C41] transition-colors"
            >
              222-308-52-39
            </a>
          </div>
        </div>
      </div>

      <!-- Right column: Form card -->
      <div class="rounded-2xl sm:rounded-3xl bg-white p-5 sm:p-8 md:p-10 shadow-xs border border-slate-100 h-full flex flex-col justify-between apple-reveal apple-delay-2 apple-card">
        <form class="flex flex-col gap-4 sm:gap-5 h-full justify-between">
          <div class="grid grid-cols-1 gap-4 sm:gap-5 sm:grid-cols-2">
            <div>
              <label for="full-name" class="mb-1.5 block text-xs sm:text-sm font-medium text-slate-700"
                >Nombre completo *</label
              >
              <input
                type="text"
                id="full-name"
                name="full-name"
                required
                placeholder="Juan Pérez"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 sm:px-4 py-2.5 sm:py-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-[#0D214B] focus:outline-none focus:ring-2 focus:ring-[#0D214B]/10"
              />
            </div>
            <div>
              <label for="phone" class="mb-1.5 block text-xs sm:text-sm font-medium text-slate-700"
                >Teléfono *</label
              >
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="222 308 5239"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 sm:px-4 py-2.5 sm:py-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-[#0D214B] focus:outline-none focus:ring-2 focus:ring-[#0D214B]/10"
              />
            </div>
          </div>


          <div class="grid grid-cols-1 gap-4 sm:gap-5 sm:grid-cols-2">
            <div>
              <label for="service" class="mb-1.5 block text-xs sm:text-sm font-medium text-slate-700"
                >Selecciona un servicio</label
              >
              <div class="relative">
                <select
                  id="service"
                  name="service"
                  class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-3.5 sm:px-4 py-2.5 sm:py-3 text-sm text-slate-800 focus:border-[#0D214B] focus:outline-none focus:ring-2 focus:ring-[#0D214B]/10"
                >
                  <option value="" selected disabled>Elige un servicio</option>
                  {
                    services.map((service) => (
                      <option value={service}>{service}</option>
                    ))
                  }
                </select>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 9l6 6 6-6"></path>
                </svg>
              </div>
            </div>

            <div>
              <label
                for="appointment-date"
                class="mb-1.5 block text-xs sm:text-sm font-medium text-slate-700">Fecha deseada</label
              >
              <div class="relative">
                <input
                  type="date"
                  id="appointment-date"
                  name="appointment-date"
                  class="w-full appearance-none rounded-xl border border-slate-200 bg-slate-50 px-3.5 sm:px-4 py-2.5 sm:py-3 pr-11 text-sm text-slate-800 focus:border-[#0D214B] focus:outline-none focus:ring-2 focus:ring-[#0D214B]/10 [&::-webkit-calendar-picker-indicator]:absolute [&::-webkit-calendar-picker-indicator]:right-3 [&::-webkit-calendar-picker-indicator]:h-4 [&::-webkit-calendar-picker-indicator]:w-4 [&::-webkit-calendar-picker-indicator]:cursor-pointer [&::-webkit-calendar-picker-indicator]:opacity-0"
                />
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                >
                  <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                  <path stroke-linecap="round" d="M8 2v4M16 2v4M3 10h18"></path>
                </svg>
              </div>
            </div>
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-xs sm:text-sm font-medium text-slate-700"
              >Mensaje (opcional)</label
            >
            <textarea
              id="message"
              name="message"
              rows="3"
              placeholder="Cuéntanos brevemente sobre tu consulta o inquietud..."
              class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-3.5 sm:px-4 py-2.5 sm:py-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-[#0D214B] focus:outline-none focus:ring-2 focus:ring-[#0D214B]/10"
            ></textarea>
          </div>

          <button
            type="submit"
            class="mt-2 inline-flex w-full sm:w-fit items-center justify-between sm:justify-start gap-3 sm:gap-4 rounded-full bg-[#0D214B] py-2 sm:py-2.5 pl-6 sm:pl-7 pr-2 text-sm sm:text-base font-semibold text-white shadow-sm transition-all hover:scale-[1.02] cursor-pointer hover:bg-[#1a3875] active:scale-95"
          >
            <span>Agendar cita</span>
            <span
              class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-full bg-white text-[#0D214B] shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                class="h-4 w-4"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
