---
const services = [
  {
    icon: "tooth",
    image:
      "https://images.unsplash.com/photo-1609840114035-3c981b782dfe?q=80&w=800&auto=format&fit=crop",
    title: "Revisión dental",
    description:
      "Exámenes de rutina y diagnóstico temprano para mantener tu sonrisa sana y protegida durante todo el año.",
  },
  {
    icon: "sparkle",
    image:
      "https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=800&auto=format&fit=crop",
    title: "Blanqueamiento dental",
    description:
      "Tratamiento profesional y seguro que devuelve el brillo natural a tus dientes sin dañar el esmalte.",
  },
  {
    icon: "align",
    image:
      "https://images.unsplash.com/photo-1629909613654-28e377c37b09?q=80&w=800&auto=format&fit=crop",
    title: "Ortodoncia",
    description:
      "Alineadores invisibles y brackets diseñados para alinear tus dientes con máxima comodidad y discreción.",
  },
  {
    icon: "shield",
    image:
      "https://images.unsplash.com/photo-1606811841689-23dfddce3e95?q=80&w=800&auto=format&fit=crop",
    title: "Tratamiento de encías",
    description:
      "Cuidado delicado y especializado para proteger tus encías y prevenir problemas periodontales a largo plazo.",
  },
];
---

<section id="servicios" class="w-full bg-white px-4 sm:px-6 md:px-14 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24">
  <div class="mx-auto max-w-7xl">
    <!-- Header -->
    <div
      class="flex flex-col gap-4 sm:gap-6 lg:flex-row lg:items-start lg:justify-between"
    >
      <span
        class="inline-block w-fit rounded-full border border-slate-300 px-4 py-1.5 sm:px-6 sm:py-2 text-xs sm:text-sm font-semibold text-slate-700 uppercase tracking-wider"
      >
        Nuestros servicios
      </span>

      <h2
        class="max-w-2xl text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight sm:leading-[1.2] text-slate-900"
      >
        Cuidado dental integral adaptado a cada sonrisa.
      </h2>
    </div>

    <!-- Cards (1 columna en móviles, 2 en tablets, 4 en pantallas grandes) -->
    <div class="mt-8 sm:mt-12 md:mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <article class="flex flex-col rounded-3xl bg-slate-50 p-3 sm:p-3.5 shadow-xs hover:shadow-md transition-all border border-slate-100/80">
            <div class="relative overflow-hidden rounded-2xl">
              <img
                src={service.image}
                alt={service.title}
                class="h-44 sm:h-48 w-full object-cover"
              />

              <span class="absolute left-3.5 top-3.5 flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-white text-[#4E8C41] shadow-sm">
                {service.icon === "tooth" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5"
                  >
                    <path d="M12 2c-1.6 0-2.9.7-3.8 1.5C7.3 2.7 6.1 2 4.7 2 2.7 2 1 3.8 1.3 6.3c.2 1.7.9 4.4 1.5 6.6.5 1.9.9 3.6 1.4 4.7.5 1.1 1.2 2 2.3 2 1.3 0 1.6-1.4 1.9-2.9.3-1.5.6-3.3 1.6-3.3s1.3 1.8 1.6 3.3c.3 1.5.6 2.9 1.9 2.9 1.1 0 1.8-.9 2.3-2 .5-1.1.9-2.8 1.4-4.7.6-2.2 1.3-4.9 1.5-6.6C22.7 3.8 21 2 19 2c-1.4 0-2.6.7-3.5 1.5C14.6 2.7 13.3 2 12 2z" />
                  </svg>
                )}
                {service.icon === "sparkle" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5"
                  >
                    <path d="M12 2l1.8 5.6L19.5 9l-5.7 1.4L12 16l-1.8-5.6L4.5 9l5.7-1.4z" />
                    <path d="M19 15l.8 2.4L22 18l-2.2.6L19 21l-.8-2.4L16 18l2.2-.6z" />
                  </svg>
                )}
                {service.icon === "align" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-5 w-5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 20V10m8 10V4m8 16v-7"
                    />
                  </svg>
                )}
                {service.icon === "shield" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-5 w-5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"
                    />
                  </svg>
                )}
              </span>
            </div>

            <div class="flex flex-1 flex-col px-2 pb-2 pt-4 sm:pt-5 justify-between">
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
                  {service.title}
                </h3>
                <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-600">
                  {service.description}
                </p>
              </div>

              <a
                href="/#contacto"
                class="mt-4 sm:mt-6 inline-flex w-fit items-center gap-2 text-xs sm:text-sm font-semibold text-[#0D214B] hover:text-[#4E8C41] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-4 w-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 10l-4 4 4 4M5 14h13a4 4 0 000-8h-1"
                  />
                </svg>
                Más información
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
