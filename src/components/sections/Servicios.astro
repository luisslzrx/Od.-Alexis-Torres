---
const services = [
  {
    image: "/images/limpieza-dental.webp",
    title: "Limpieza dental",
    description:
      "Eliminación profesional de sarro y placa bacteriana para prevenir caries, cuidar tus encías y mantener tu salud bucal.",
  },
  {
    image: "/images/blanqueamiento-dental.webp",
    title: "Blanqueamiento dental",
    description:
      "Tratamiento estético seguro y eficaz para aclarar varios tonos tu esmalte, eliminando manchas y devolviendo el brillo a tu sonrisa.",
  },
  {
    image: "/images/corona-dental.webp",
    title: "Corona dental",
    description:
      "Restauraciones de máxima durabilidad y apariencia natural para proteger y devolver la anatomía a piezas dañadas.",
  },
  {
    image: "/images/extraccion-dental.webp",
    title: "Extracciones dentales",
    description:
      "Procedimientos seguros, controlados e indoloros para la remoción de piezas comprometidas o muelas del juicio.",
  },
  {
    image: "/images/guarda-dental.webp",
    title: "Guarda dental",
    description:
      "Férulas personalizadas de protección para aliviar el bruxismo, proteger del desgaste y relajar la articulación mandibular.",
  },
  {
    image: "/images/resina.webp",
    title: "Resina",
    description:
      "Restauraciones estéticas directas que devuelven la forma, color y función natural a tus dientes con acabado imperceptible.",
  },
];
---

<section
  id="servicios"
  class="w-full overflow-hidden bg-white px-4 sm:px-6 md:px-14 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24"
>
  <div class="mx-auto max-w-7xl">
    <!-- Header with Title & Navigation Controls -->
    <div
      class="flex flex-col gap-4 sm:gap-6 sm:flex-row sm:items-end sm:justify-between apple-reveal"
    >
      <div>
        <span
          class="inline-block w-fit rounded-full border border-slate-300 px-4 py-1.5 sm:px-6 sm:py-2 text-xs sm:text-sm font-semibold text-slate-700 uppercase tracking-wider"
        >
          Nuestros servicios
        </span>

        <h2
          class="mt-3 sm:mt-4 max-w-2xl text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold leading-tight sm:leading-[1.15] text-slate-900"
        >
          Cuidado dental integral adaptado a cada sonrisa.
        </h2>
      </div>

      <!-- Navigation Arrows -->
      <div class="flex shrink-0 items-center gap-2.5 self-end sm:self-auto">
        <button
          id="servicios-prev"
          type="button"
          aria-label="Servicios anteriores"
          class="flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full border border-slate-300 text-slate-700 transition-all hover:bg-slate-100 hover:border-slate-400 cursor-pointer active:scale-95"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-4 w-4 sm:h-5 sm:w-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 12H5m0 0l6-6m-6 6l6 6"></path>
          </svg>
        </button>
        <button
          id="servicios-next"
          type="button"
          aria-label="Siguientes servicios"
          class="flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-[#0D214B] text-white transition-all hover:bg-[#183573] hover:scale-105 cursor-pointer active:scale-95 shadow-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-4 w-4 sm:h-5 sm:w-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14m0 0l-6-6m6 6l-6 6"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Carrusel de servicios: 4 visibles en desktop, desplazable horizontalmente -->
    <div
      id="servicios-slider"
      class="mt-8 sm:mt-12 md:mt-14 flex items-stretch gap-5 overflow-x-auto scroll-smooth pb-4 select-none snap-x snap-mandatory [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        services.map((service, index) => (
          <article
            class={`group flex flex-col rounded-3xl bg-slate-50 p-3 sm:p-3.5 shadow-xs hover:shadow-md transition-all border border-slate-100/80 w-[82vw] max-w-[290px] sm:w-[calc(50%-10px)] sm:max-w-none lg:w-[calc((100%-60px)/4)] shrink-0 snap-start apple-reveal apple-card ${index === 0 ? "" : index === 1 ? "apple-delay-1" : index === 2 ? "apple-delay-2" : index === 3 ? "apple-delay-3" : index === 4 ? "apple-delay-4" : "apple-delay-5"}`}
          >
            <div class="relative overflow-hidden rounded-2xl">
              <img
                src={service.image}
                alt={service.title}
                class="h-60 sm:h-64 lg:h-72 w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>

            <div class="flex flex-1 flex-col px-2 pb-2 pt-4 sm:pt-5 justify-between">
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
                  {service.title}
                </h3>
                <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-600 line-clamp-3">
                  {service.description}
                </p>
              </div>

              <a
                href="/#contacto"
                class="mt-4 sm:mt-6 inline-flex w-fit items-center gap-2 text-xs sm:text-sm font-semibold text-[#0D214B] hover:text-[#4E8C41] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-4 w-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 10l-4 4 4 4M5 14h13a4 4 0 000-8h-1"
                  />
                </svg>
                Más información
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  function setupServiciosSlider() {
    const slider = document.getElementById("servicios-slider");
    const prevBtn = document.getElementById("servicios-prev");
    const nextBtn = document.getElementById("servicios-next");

    if (!slider || !prevBtn || !nextBtn) return;

    function getScrollAmount() {
      const firstCard = slider?.querySelector<HTMLElement>("article");
      if (firstCard) {
        return firstCard.offsetWidth + 20; // Ancho de tarjeta + gap
      }
      return window.innerWidth < 640 ? 280 : 320;
    }

    prevBtn.addEventListener("click", () => {
      slider.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      slider.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
    });
  }

  setupServiciosSlider();
  document.addEventListener("astro:page-load", setupServiciosSlider);
</script>
