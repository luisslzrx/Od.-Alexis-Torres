---
const testimonials = [
  {
    quote:
      "La atención y el cuidado con el que me trataron superaron todas mis expectativas. Me devolvieron la seguridad de sonreír sin pena y el proceso fue completamente cómodo e indoloro.",
    name: "Sofía Valenzuela",
    role: "Diseñadora Gráfica",
    year: "2026",
  },
  {
    quote:
      "Excelente profesionalismo del Dr. Alexis y todo su equipo. La tecnología moderna que utilizan hace que cada tratamiento sea rápido, preciso y con resultados estéticos increíbles desde la primera cita.",
    name: "Carlos Mendoza",
    role: "Empresario",
    year: "2026",
  },
  {
    quote:
      "Tenía mucho miedo de ir al dentista hasta que llegué a este consultorio. La calidez humana, la paciencia y las instalaciones de primer nivel me hicieron sentir en absoluta tranquilidad y confianza.",
    name: "Mariana Gómez",
    role: "Arquitecta",
    year: "2026",
  },
];
---

<section
  id="testimonios"
  class="w-full bg-white px-4 sm:px-6 md:px-14 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="grid grid-cols-1 gap-8 sm:gap-10 lg:grid-cols-12 lg:gap-12 items-center"
    >
      <!-- Izquierda: insignia, titular y resumen de satisfacción -->
      <div class="lg:col-span-4 flex flex-col items-center sm:items-start text-center sm:text-left apple-reveal">
        <span
          class="inline-block w-fit rounded-full border border-slate-300 px-4 py-1.5 sm:px-6 sm:py-2 text-xs sm:text-sm font-semibold text-slate-700 uppercase tracking-wider"
        >
          Testimonios
        </span>

        <h2
          class="mt-4 sm:mt-5 text-2xl sm:text-3xl md:text-4xl font-bold leading-tight sm:leading-[1.2] text-slate-900 tracking-tight"
        >
          Sonrisas que confían en nosotros
        </h2>

        <p class="mt-3 sm:mt-4 text-sm sm:text-base leading-relaxed text-slate-600">
          La satisfacción y salud de nuestros pacientes es nuestro mayor compromiso en cada consulta.
        </p>

        <!-- Bloque de calificación y confianza -->
        <div class="mt-6 sm:mt-8 pt-6 border-t border-slate-100 w-full flex flex-col items-center sm:items-start">
          <div class="flex items-center gap-1 text-[#4E8C41]">
            <svg class="h-4 w-4 sm:h-5 sm:w-5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="h-4 w-4 sm:h-5 sm:w-5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="h-4 w-4 sm:h-5 sm:w-5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="h-4 w-4 sm:h-5 sm:w-5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg class="h-4 w-4 sm:h-5 sm:w-5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </div>
          <div class="mt-2 flex items-baseline gap-2">
            <span class="text-xl sm:text-2xl font-bold text-slate-900">4.9 / 5</span>
            <span class="text-xs sm:text-sm text-slate-500 font-medium">· Pacientes satisfechos</span>
          </div>
        </div>
      </div>

      <!-- Derecha: Tarjeta destacada de testimonio con controles -->
      <div class="lg:col-span-8 apple-reveal apple-delay-1">
        <div
          class="relative rounded-3xl bg-slate-50 border border-slate-200/70 p-6 sm:p-10 md:p-12 shadow-xs apple-card"
        >
          <!-- Comillas decorativas -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-8 w-8 sm:h-10 sm:w-10 text-[#4E8C41]/80 mb-3"
          >
            <path
              d="M9.5 4C6 4 3 7.1 3 11.2c0 3.3 2.1 5.6 4.9 5.6 2.2 0 3.8-1.6 3.8-3.7 0-1.9-1.3-3.3-3-3.3-.3 0-.6 0-.8.1.3-1.7 2-3.2 4-3.4L11.5 4zm11 0c-3.5 0-6.5 3.1-6.5 7.2 0 3.3 2.1 5.6 4.9 5.6 2.2 0 3.8-1.6 3.8-3.7 0-1.9-1.3-3.3-3-3.3-.3 0-.6 0-.8.1.3-1.7 2-3.2 4-3.4L22.5 4z"
            ></path>
          </svg>

          <div
            id="testimonial-swipe-area"
            class="min-h-[160px] sm:min-h-[190px] flex flex-col justify-center cursor-grab active:cursor-grabbing"
          >
            <div id="testimonial-text-wrapper" class="transition-opacity duration-300">
              <p
                id="testimonial-quote"
                class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold leading-relaxed sm:leading-snug text-slate-900"
              >
                "{testimonials[0].quote}"
              </p>

              <div
                class="mt-8 pt-6 border-t border-slate-200/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
              >
                <div>
                  <p
                    id="testimonial-author"
                    class="text-base sm:text-lg font-bold text-slate-900"
                  >
                    {testimonials[0].name}
                  </p>
                  <div class="flex items-center gap-2 mt-0.5">
                    <p
                      id="testimonial-role"
                      class="text-xs sm:text-sm text-slate-500 font-medium"
                    >
                      {testimonials[0].role}
                    </p>
                    <span class="text-slate-300">·</span>
                    <span
                      id="testimonial-year"
                      class="text-xs sm:text-sm font-medium text-slate-500"
                    >
                      {testimonials[0].year}
                    </span>
                  </div>
                </div>

                <!-- Controles y contador -->
                <div class="flex items-center gap-3 self-end sm:self-auto">
                  <span
                    id="testimonial-counter"
                    class="rounded-full bg-white px-3.5 py-1 text-xs font-bold text-slate-600 border border-slate-200 shadow-2xs"
                  >
                    1 / {testimonials.length}
                  </span>
                  <div class="flex items-center gap-2">
                    <button
                      id="testimonial-prev"
                      type="button"
                      aria-label="Testimonio anterior"
                      class="flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full border border-slate-300 bg-white text-slate-700 transition-all hover:bg-slate-100 cursor-pointer active:scale-95 shadow-2xs"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="h-4 w-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19 12H5m0 0l6-6m-6 6l6 6"
                        ></path>
                      </svg>
                    </button>
                    <button
                      id="testimonial-next"
                      type="button"
                      aria-label="Siguiente testimonio"
                      class="flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-[#0D214B] text-white transition-all hover:scale-105 hover:bg-[#1a3875] cursor-pointer active:scale-95 shadow-sm"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="h-4 w-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M5 12h14m0 0l-6-6m6 6l-6 6"
                        ></path>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ testimonials }}>
  let currentIndex = 0;

  const yearEl = document.getElementById("testimonial-year");
  const quoteEl = document.getElementById("testimonial-quote");
  const authorEl = document.getElementById("testimonial-author");
  const roleEl = document.getElementById("testimonial-role");
  const counterEl = document.getElementById("testimonial-counter");
  const textWrapper = document.getElementById("testimonial-text-wrapper");
  const swipeArea = document.getElementById("testimonial-swipe-area");

  const prevBtn = document.getElementById("testimonial-prev");
  const nextBtn = document.getElementById("testimonial-next");

  function updateTestimonial(index) {
    if (textWrapper) {
      textWrapper.style.opacity = "0";

      setTimeout(() => {
        const item = testimonials[index];
        if (quoteEl) quoteEl.textContent = `"${item.quote}"`;
        if (authorEl) authorEl.textContent = item.name;
        if (roleEl) roleEl.textContent = item.role;
        if (yearEl) yearEl.textContent = item.year;
        if (counterEl) {
          counterEl.textContent = `${index + 1} / ${testimonials.length}`;
        }

        textWrapper.style.opacity = "1";
      }, 180);
    }
  }

  function goPrev() {
    currentIndex = (currentIndex - 1 + testimonials.length) % testimonials.length;
    updateTestimonial(currentIndex);
  }

  function goNext() {
    currentIndex = (currentIndex + 1) % testimonials.length;
    updateTestimonial(currentIndex);
  }

  prevBtn?.addEventListener("click", goPrev);
  nextBtn?.addEventListener("click", goNext);

  // Soporte táctil para deslizar (swipe) en móviles
  let touchStartX = 0;
  let touchEndX = 0;

  swipeArea?.addEventListener(
    "touchstart",
    (e) => {
      touchStartX = e.changedTouches[0].screenX;
    },
    { passive: true }
  );

  swipeArea?.addEventListener(
    "touchend",
    (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    },
    { passive: true }
  );

  function handleSwipe() {
    const diff = touchEndX - touchStartX;
    if (Math.abs(diff) > 40) {
      if (diff < 0) {
        goNext();
      } else {
        goPrev();
      }
    }
  }
</script>
