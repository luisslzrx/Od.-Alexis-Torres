---
const testimonials = [
  {
    quote:
      "La atención y el cuidado con el que me trataron superaron todas mis expectativas. Me devolvieron la seguridad de sonreír sin pena y el proceso fue completamente cómodo e indoloro.",
    name: "Sofía Valenzuela",
    role: "Diseñadora Gráfica",
    image:
      "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=600&auto=format&fit=crop",
    year: "2026",
  },
  {
    quote:
      "Excelente profesionalismo del Dr. Alexis y todo su equipo. La tecnología moderna que utilizan hace que cada tratamiento sea rápido, preciso y con resultados estéticos increíbles desde la primera cita.",
    name: "Carlos Mendoza",
    role: "Empresario",
    image:
      "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=600&auto=format&fit=crop",
    year: "2026",
  },
  {
    quote:
      "Tenía mucho miedo de ir al dentista hasta que llegué a este consultorio. La calidez humana, la paciencia y las instalaciones de primer nivel me hicieron sentir en absoluta tranquilidad y confianza.",
    name: "Mariana Gómez",
    role: "Arquitecta",
    image:
      "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=600&auto=format&fit=crop",
    year: "2026",
  },
];
---

<section
  id="testimonios"
  class="w-full bg-white px-4 sm:px-6 md:px-14 py-14 sm:py-20 md:py-28 scroll-mt-20 sm:scroll-mt-24"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="grid grid-cols-1 gap-8 sm:gap-10 lg:grid-cols-[280px_1fr_auto] lg:gap-12 items-center"
    >
      <!-- Izquierda: insignia y foto del paciente -->
      <div class="flex flex-col items-center sm:items-start text-center sm:text-left">
        <span
          class="inline-block w-fit rounded-full border border-slate-300 px-4 py-1.5 sm:px-6 sm:py-2 text-xs sm:text-sm font-semibold text-slate-700 uppercase tracking-wider"
        >
          Testimonios
        </span>

        <div class="mt-6 sm:mt-8 pt-2">
          <div class="relative h-56 w-56 sm:h-64 sm:w-64 overflow-hidden rounded-3xl bg-slate-100 shadow-sm mx-auto sm:mx-0 border border-slate-100">
            <img
              id="testimonial-image"
              src={testimonials[0].image}
              alt={testimonials[0].name}
              class="h-full w-full object-cover transition-opacity duration-300"
            />
          </div>
          <div
            class="mt-3 flex w-56 sm:w-64 mx-auto sm:mx-0 items-center justify-between text-xs sm:text-sm font-medium text-slate-500"
          >
            <span>Pacientes satisfechos</span>
            <span id="testimonial-year" class="font-semibold text-slate-700">{testimonials[0].year}</span>
          </div>
        </div>
      </div>

      <!-- Centro: cita y autor -->
      <div id="testimonial-swipe-area" class="flex flex-col justify-center min-h-[220px] sm:min-h-[260px] cursor-grab active:cursor-grabbing">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="h-8 w-8 sm:h-10 sm:w-10 text-[#4E8C41]/80 mb-2"
        >
          <path
            d="M9.5 4C6 4 3 7.1 3 11.2c0 3.3 2.1 5.6 4.9 5.6 2.2 0 3.8-1.6 3.8-3.7 0-1.9-1.3-3.3-3-3.3-.3 0-.6 0-.8.1.3-1.7 2-3.2 4-3.4L11.5 4zm11 0c-3.5 0-6.5 3.1-6.5 7.2 0 3.3 2.1 5.6 4.9 5.6 2.2 0 3.8-1.6 3.8-3.7 0-1.9-1.3-3.3-3-3.3-.3 0-.6 0-.8.1.3-1.7 2-3.2 4-3.4L22.5 4z"
          ></path>
        </svg>

        <div id="testimonial-text-wrapper" class="transition-opacity duration-300">
          <p
            id="testimonial-quote"
            class="mt-1 sm:mt-2 text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold leading-snug sm:leading-[1.35] text-slate-900"
          >
            "{testimonials[0].quote}"
          </p>

          <div class="mt-6 sm:mt-8 flex items-center justify-between sm:justify-start gap-3">
            <div>
              <p id="testimonial-author" class="text-base sm:text-lg font-bold text-slate-900">
                {testimonials[0].name}
              </p>
              <p id="testimonial-role" class="text-xs sm:text-sm text-slate-500">
                {testimonials[0].role}
              </p>
            </div>
            <!-- Píldora contadora de testimonios -->
            <span
              id="testimonial-counter"
              class="ml-2 sm:ml-4 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600 border border-slate-200/60"
            >
              1 / {testimonials.length}
            </span>
          </div>
        </div>
      </div>

      <!-- Derecha: flechas de navegación -->
      <div class="flex items-center justify-center sm:justify-start gap-3 self-center lg:self-center">
        <button
          id="testimonial-prev"
          type="button"
          aria-label="Testimonio anterior"
          class="flex h-11 w-11 sm:h-12 sm:w-12 md:h-14 md:w-14 items-center justify-center rounded-full border border-slate-300 text-slate-700 transition-all hover:bg-slate-100 cursor-pointer active:scale-95"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-4 w-4 sm:h-5 sm:w-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 12H5m0 0l6-6m-6 6l6 6"
            ></path>
          </svg>
        </button>
        <button
          id="testimonial-next"
          type="button"
          aria-label="Siguiente testimonio"
          class="flex h-11 w-11 sm:h-12 sm:w-12 md:h-14 md:w-14 items-center justify-center rounded-full bg-[#0D214B] text-white transition-all hover:scale-105 hover:bg-[#1a3875] cursor-pointer active:scale-95 shadow-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            class="h-4 w-4 sm:h-5 sm:w-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14m0 0l-6-6m6 6l-6 6"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ testimonials }}>
  let currentIndex = 0;

  const imageEl = document.getElementById("testimonial-image");
  const yearEl = document.getElementById("testimonial-year");
  const quoteEl = document.getElementById("testimonial-quote");
  const authorEl = document.getElementById("testimonial-author");
  const roleEl = document.getElementById("testimonial-role");
  const counterEl = document.getElementById("testimonial-counter");
  const textWrapper = document.getElementById("testimonial-text-wrapper");
  const swipeArea = document.getElementById("testimonial-swipe-area");

  const prevBtn = document.getElementById("testimonial-prev");
  const nextBtn = document.getElementById("testimonial-next");

  function updateTestimonial(index) {
    if (textWrapper && imageEl) {
      textWrapper.style.opacity = "0";
      imageEl.style.opacity = "0";

      setTimeout(() => {
        const item = testimonials[index];
        if (quoteEl) quoteEl.textContent = `"${item.quote}"`;
        if (authorEl) authorEl.textContent = item.name;
        if (roleEl) roleEl.textContent = item.role;
        if (yearEl) yearEl.textContent = item.year;
        if (imageEl) {
          imageEl.src = item.image;
          imageEl.alt = item.name;
        }
        if (counterEl) {
          counterEl.textContent = `${index + 1} / ${testimonials.length}`;
        }

        textWrapper.style.opacity = "1";
        imageEl.style.opacity = "1";
      }, 180);
    }
  }

  function goPrev() {
    currentIndex = (currentIndex - 1 + testimonials.length) % testimonials.length;
    updateTestimonial(currentIndex);
  }

  function goNext() {
    currentIndex = (currentIndex + 1) % testimonials.length;
    updateTestimonial(currentIndex);
  }

  prevBtn?.addEventListener("click", goPrev);
  nextBtn?.addEventListener("click", goNext);

  // Soporte táctil para deslizar (swipe) en móviles
  let touchStartX = 0;
  let touchEndX = 0;

  swipeArea?.addEventListener(
    "touchstart",
    (e) => {
      touchStartX = e.changedTouches[0].screenX;
    },
    { passive: true }
  );

  swipeArea?.addEventListener(
    "touchend",
    (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    },
    { passive: true }
  );

  function handleSwipe() {
    const diff = touchEndX - touchStartX;
    if (Math.abs(diff) > 40) {
      if (diff < 0) {
        goNext();
      } else {
        goPrev();
      }
    }
  }
</script>
