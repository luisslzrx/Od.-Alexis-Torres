    </style>

    <!-- 8. JAVASCRIPT: SESIÓN, EDICIÓN, GENERACIÓN DE MARKDOWN Y GUARDADO -->
    <script>
      const AUTH_KEY = "od_alexis_blog_auth";
      const VALID_USER = "alexis";
      const VALID_PASS = "TorresDental2026!";

      // Cargar lista de posts para edición en memoria
      let postsList: Array<{
        slug: string;
        title: string;
        description: string;
        date: string;
        author: string;
        tag: string;
        readTime: string;
        image: string;
        content: string;
      }> = [];

      try {
        const scriptData = document.getElementById("posts-data-json")?.textContent;
        if (scriptData) {
          postsList = JSON.parse(scriptData);
        }
      } catch (e) {
        console.error("Error al cargar posts para edición:", e);
      }

      // Estado de edición actual (null = creando nueva nota)
      let currentEditingSlug: string | null = null;

      const loginView = document.getElementById("login-view");
      const dashboardView = document.getElementById("dashboard-view");
      const loginForm = document.getElementById("login-form") as HTMLFormElement;
      const loginError = document.getElementById("login-error");
      const logoutBtn = document.getElementById("logout-btn");
      const newPostTopBtn = document.getElementById("new-post-top-btn");

      const editingIndicator = document.getElementById("editing-indicator");
      const editingTitleLabel = document.getElementById("editing-title-label");
      const cancelEditBtn = document.getElementById("cancel-edit-btn");
      const formHeading = document.getElementById("form-heading");
      const formSubheading = document.getElementById("form-subheading");

      const postForm = document.getElementById("post-form") as HTMLFormElement;
      const titleInput = document.getElementById("post-title") as HTMLInputElement;
      const slugInput = document.getElementById("post-slug") as HTMLInputElement;
      const tagSelect = document.getElementById("post-tag") as HTMLSelectElement;
      const readtimeInput = document.getElementById("post-readtime") as HTMLInputElement;
      const dateInput = document.getElementById("post-date") as HTMLInputElement;
      const authorInput = document.getElementById("post-author") as HTMLInputElement;
      const imageInput = document.getElementById("post-image") as HTMLInputElement;
      const descInput = document.getElementById("post-description") as HTMLTextAreaElement;
      const contentInput = document.getElementById("post-content") as HTMLTextAreaElement;
      const submitPostBtn = document.getElementById("submit-post-btn") as HTMLButtonElement;

      const slugPreview = document.getElementById("slug-preview");
      const previewTitle = document.getElementById("preview-title");
      const previewTag = document.getElementById("preview-tag");
      const previewMeta = document.getElementById("preview-meta");
      const previewDesc = document.getElementById("preview-desc");
      const previewImage = document.getElementById("preview-image") as HTMLImageElement;
      const previewBody = document.getElementById("preview-body");

      const statusToast = document.getElementById("status-toast");
      const toastMessage = document.getElementById("toast-message");
      const closeToast = document.getElementById("close-toast");

      const downloadMdBtn = document.getElementById("download-md-btn");
      const copyMdBtn = document.getElementById("copy-md-btn");

      // Control de sesión
      function checkAuth() {
        const isAuth = sessionStorage.getItem(AUTH_KEY);
        if (isAuth === "true") {
          loginView?.classList.add("hidden");
          dashboardView?.classList.remove("hidden");
        } else {
          loginView?.classList.remove("hidden");
          dashboardView?.classList.add("hidden");
        }
      }

      loginForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        const user = (document.getElementById("username") as HTMLInputElement).value.trim();
        const pass = (document.getElementById("password") as HTMLInputElement).value;

        if ((user === VALID_USER || user === "admin") && pass === VALID_PASS) {
          sessionStorage.setItem(AUTH_KEY, "true");
          loginError?.classList.add("hidden");
          checkAuth();
        } else {
          loginError?.classList.remove("hidden");
        }
      });

      logoutBtn?.addEventListener("click", () => {
        sessionStorage.removeItem(AUTH_KEY);
        checkAuth();
      });

      // Slug
      function slugify(text: string): string {
        return text
          .toString()
          .toLowerCase()
          .trim()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9 -]/g, "")
          .replace(/\s+/g, "-")
          .replace(/-+/g, "-")
          .replace(/^-|-$/g, "");
      }

      titleInput?.addEventListener("input", () => {
        if (!currentEditingSlug && !slugInput.dataset.manual) {
          const generated = slugify(titleInput.value);
          slugInput.value = generated;
          if (slugPreview) slugPreview.textContent = generated || "...";
        }
        updatePreview();
      });

      slugInput?.addEventListener("input", () => {
        slugInput.dataset.manual = "true";
        if (slugPreview) slugPreview.textContent = slugify(slugInput.value) || "...";
      });

      // Presets
      document.querySelectorAll(".preset-pill").forEach((btn) => {
        btn.addEventListener("click", () => {
          const url = btn.getAttribute("data-img");
          if (url && imageInput) {
            imageInput.value = url;
            updatePreview();
          }
        });
      });

      // Herramientas Markdown
      document.querySelectorAll(".tool-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tool = btn.getAttribute("data-tool");
          const start = contentInput.selectionStart;
          const end = contentInput.selectionEnd;
          const text = contentInput.value;
          const sel = text.substring(start, end);

          let rep = "";
          switch (tool) {
            case "h2":
              rep = `\n\n## ${sel || "Título de sección"}\n`;
              break;
            case "h3":
              rep = `\n\n### ${sel || "Subtítulo"}\n`;
              break;
            case "bold":
              rep = `**${sel || "texto en negrita"}**`;
              break;
            case "italic":
              rep = `*${sel || "texto en cursiva"}*`;
              break;
            case "quote":
              rep = `\n> ${sel || "Cita o recomendación profesional..."}\n`;
              break;
            case "list":
              rep = `\n- ${sel || "Punto uno"}\n- Punto dos\n`;
              break;
          }

          contentInput.value = text.substring(0, start) + rep + text.substring(end);
          contentInput.focus();
          updatePreview();
        });
      });

      // Actualizar vista previa
      function updatePreview() {
        if (previewTitle) previewTitle.textContent = titleInput.value || "Título del artículo";
        if (previewTag) previewTag.textContent = tagSelect.value || "Salud Bucal";
        if (previewDesc) previewDesc.textContent = descInput.value || "Resumen del artículo...";
        if (previewMeta) {
          previewMeta.textContent = `${dateInput.value} · ${readtimeInput.value} · Por ${authorInput.value}`;
        }
        if (previewImage && imageInput.value) {
          previewImage.src = imageInput.value;
        }

        if (previewBody) {
          const raw = contentInput.value.trim();
          if (!raw) {
            previewBody.innerHTML = "<em>El texto formateado aparecerá aquí mientras escribes...</em>";
          } else {
            let html = raw
              .replace(/^## (.*$)/gim, '<strong style="display:block;font-size:0.95rem;color:#0D214B;margin-top:0.5rem;">$1</strong>')
              .replace(/^### (.*$)/gim, '<strong style="display:block;font-size:0.875rem;color:#1e293b;margin-top:0.35rem;">$1</strong>')
              .replace(/^\> (.*$)/gim, '<blockquote style="border-left:3px solid #4E8C41;padding-left:0.5rem;color:#475569;font-style:italic;margin:0.4rem 0;">$1</blockquote>')
              .replace(/\*\*(.*)\*\*/gim, '<strong>$1</strong>')
              .replace(/\*(.*)\*/gim, '<em>$1</em>')
              .replace(/^- (.*$)/gim, '<span style="display:block;padding-left:0.75rem;">• $1</span>')
              .replace(/\n$/gim, '<br />');
            previewBody.innerHTML = html;
          }
        }
      }

      [titleInput, slugInput, tagSelect, readtimeInput, dateInput, authorInput, imageInput, descInput, contentInput].forEach((el) => {
        el?.addEventListener("input", updatePreview);
      });

      // 3. FUNCIÓN DE EDICIÓN DE NOTAS
      function loadPostForEdit(slug: string) {
        const post = postsList.find((p) => p.slug === slug);
        if (!post) {
          showToast(`No se encontró la nota con identificador: ${slug}`, true);
          return;
        }

        currentEditingSlug = post.slug;

        // Rellenar campos del formulario
        titleInput.value = post.title;
        slugInput.value = post.slug;
        slugInput.dataset.manual = "true";
        if (slugPreview) slugPreview.textContent = post.slug;

        tagSelect.value = post.tag || "Salud Bucal";
        readtimeInput.value = post.readTime || "5 min de lectura";
        dateInput.value = post.date || "03 Mar 2026";
        authorInput.value = post.author || "Od. Alexis Torres";
        imageInput.value = post.image || "https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=1000&auto=format&fit=crop";
        descInput.value = post.description || "";
        contentInput.value = post.content || "";

        // Actualizar interfaz a "Modo Edición"
        if (editingIndicator) editingIndicator.classList.remove("hidden");
        if (editingTitleLabel) editingTitleLabel.textContent = post.title;
        if (formHeading) formHeading.textContent = `Editar nota: "${post.title}"`;
        if (formSubheading) formSubheading.textContent = `Modifica los campos y haz clic en "Actualizar nota" para guardar los cambios en ${post.slug}.md`;
        if (submitPostBtn) submitPostBtn.textContent = "Actualizar y guardar cambios";

        // Marcar en la lista la nota que se está editando
        document.querySelectorAll(".post-item").forEach((el) => {
          if (el.getAttribute("data-item-slug") === slug) {
            el.classList.add("is-editing");
          } else {
            el.classList.remove("is-editing");
          }
        });

        // Scroll suave al formulario
        postForm?.scrollIntoView({ behavior: "smooth", block: "start" });

        updatePreview();
        showToast(`Nota cargada para edición: "${post.title}"`);
      }

      function resetFormToNew() {
        currentEditingSlug = null;
        postForm?.reset();

        // Valores por defecto
        delete slugInput.dataset.manual;
        readtimeInput.value = "5 min de lectura";
        dateInput.value = "03 Mar 2026";
        authorInput.value = "Od. Alexis Torres";
        imageInput.value = "https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=1000&auto=format&fit=crop";
        tagSelect.value = "Salud Bucal";
        if (slugPreview) slugPreview.textContent = "...";

        // Restaurar interfaz
        if (editingIndicator) editingIndicator.classList.add("hidden");
        if (formHeading) formHeading.textContent = "Crear nueva nota de blog";
        if (formSubheading) formSubheading.textContent = "Escribe la nota y guárdala directamente o descárgala en Markdown (.md).";
        if (submitPostBtn) submitPostBtn.textContent = "Guardar y publicar nota";

        document.querySelectorAll(".post-item").forEach((el) => el.classList.remove("is-editing"));
        updatePreview();
      }

      // Eventos de los botones de editar
      document.querySelectorAll(".btn-edit").forEach((btn) => {
        btn.addEventListener("click", () => {
          const slug = btn.getAttribute("data-edit-slug");
          if (slug) loadPostForEdit(slug);
        });
      });

      cancelEditBtn?.addEventListener("click", resetFormToNew);
      newPostTopBtn?.addEventListener("click", resetFormToNew);

      // Exportar / Descargar Markdown
      function getMarkdown(): { filename: string; content: string } {
        const slug = slugify(slugInput.value || titleInput.value || "nota-actualizada");
        const filename = `${slug}.md`;
        const content = `---
title: "${titleInput.value.replace(/"/g, '\\"')}"
description: "${descInput.value.replace(/"/g, '\\"')}"
date: "${dateInput.value || '03 Mar 2026'}"
author: "${authorInput.value || 'Od. Alexis Torres'}"
tag: "${tagSelect.value || 'Salud Bucal'}"
readTime: "${readtimeInput.value || '5 min de lectura'}"
image: "${imageInput.value || 'https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=1000&auto=format&fit=crop'}"
avatar: "/logo.png"
---

${contentInput.value.trim()}
`;
        return { filename, content };
      }

      function showToast(msg: string, isError = false) {
        if (!statusToast || !toastMessage) return;
        toastMessage.textContent = msg;
        statusToast.className = `alert-box ${isError ? "error" : "success"}`;
        statusToast.classList.remove("hidden");
      }

      closeToast?.addEventListener("click", () => {
        statusToast?.classList.add("hidden");
      });

      function downloadFile(filename: string, content: string) {
        const blob = new Blob([content], { type: "text/markdown;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      downloadMdBtn?.addEventListener("click", () => {
        const { filename, content } = getMarkdown();
        downloadFile(filename, content);
        showToast(`Archivo "${filename}" descargado con éxito. Guárdalo en src/content/blog/`);
      });

      copyMdBtn?.addEventListener("click", async () => {
        const { content } = getMarkdown();
        try {
          await navigator.clipboard.writeText(content);
          showToast("¡Contenido Markdown copiado al portapapeles!");
        } catch {
          showToast("No se pudo copiar automáticamente.", true);
        }
      });

      // Submit: Guardar o Actualizar
      postForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const origText = submitPostBtn.textContent || "";
        submitPostBtn.disabled = true;
        submitPostBtn.textContent = currentEditingSlug ? "Actualizando nota..." : "Guardando nota...";

        const { filename, content } = getMarkdown();
        const slug = slugify(slugInput.value || titleInput.value);

        try {
          const res = await fetch("/api/guardar-nota", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              title: titleInput.value,
              slug,
              oldSlug: currentEditingSlug,
              description: descInput.value,
              tag: tagSelect.value,
              readTime: readtimeInput.value,
              date: dateInput.value,
              author: authorInput.value,
              image: imageInput.value,
              content: contentInput.value,
              password: VALID_PASS,
            }),
          });

          if (res.ok) {
            const data = await res.json();
            const actionVerb = currentEditingSlug ? "actualizada" : "creada y publicada";
            showToast(`¡Nota "${filename}" ${actionVerb} exitosamente!`);

            // Actualizar en la lista en memoria
            const existingIdx = postsList.findIndex((p) => p.slug === (currentEditingSlug || slug));
            const updatedObj = {
              slug,
              title: titleInput.value,
              description: descInput.value,
              date: dateInput.value,
              author: authorInput.value,
              tag: tagSelect.value,
              readTime: readtimeInput.value,
              image: imageInput.value,
              content: contentInput.value,
            };

            if (existingIdx >= 0) {
              postsList[existingIdx] = updatedObj;
            } else {
              postsList.push(updatedObj);
            }

            // Actualizar etiqueta del item en la lista visual
            const visualItem = document.querySelector(`.post-item[data-item-slug="${currentEditingSlug || slug}"]`);
            if (visualItem) {
              const titleEl = visualItem.querySelector(".post-title");
              if (titleEl) titleEl.textContent = titleInput.value;
            }
          } else {
            downloadFile(filename, content);
            showToast(`Nota generada. Se ha descargado "${filename}" para guardarla en src/content/blog/`);
          }
        } catch {
          downloadFile(filename, content);
          showToast(`Se ha descargado "${filename}". Colócalo en src/content/blog/`);
        } finally {
          submitPostBtn.disabled = false;
          submitPostBtn.textContent = origText;
        }
      });

      // Init
      checkAuth();
      updatePreview();
    </script>
  </body>
</html>
