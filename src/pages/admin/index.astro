        --color-primary: #0D214B;
        --color-primary-hover: #16326d;
        --color-green: #4E8C41;
        --color-green-hover: #3d7232;
        --color-bg: #f8fafc;
        --color-card: #ffffff;
        --color-border: #e2e8f0;
        --color-text-main: #0f172a;
        --color-text-muted: #64748b;
        --radius-lg: 18px;
        --radius-md: 12px;
        --radius-sm: 8px;
      }

      * {
        box-sizing: border-box;
