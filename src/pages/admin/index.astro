---
// Vista oculta de administración para agregar y editar notas de blog
// Ruta: /admin
import "../../styles/global.css";
import fs from "node:fs";
import path from "node:path";

const blogDir = path.resolve(process.cwd(), "src/content/blog");
let existingPosts: Array<{
  slug: string;
  title: string;
  description: string;
  date: string;
  author: string;
  tag: string;
  readTime: string;
  image: string;
  content: string;
}> = [];

try {
  if (fs.existsSync(blogDir)) {
    const fileNames = fs.readdirSync(blogDir).filter((file) => file.endsWith(".md"));
    existingPosts = fileNames.map((fileName) => {
      const filePath = path.join(blogDir, fileName);
      const raw = fs.readFileSync(filePath, "utf-8");
      const slug = fileName.replace(".md", "");

      // Separar frontmatter y markdown
      const match = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
      const frontmatterStr = match ? match[1] : "";
      const content = match ? match[2].trim() : raw.trim();

      const title = frontmatterStr.match(/title:\s*"(.*?)"/)?.[1] || "";
      const description = frontmatterStr.match(/description:\s*"(.*?)"/)?.[1] || "";
      const date = frontmatterStr.match(/date:\s*"(.*?)"/)?.[1] || "";
      const author = frontmatterStr.match(/author:\s*"(.*?)"/)?.[1] || "Od. Alexis Torres";
      const tag = frontmatterStr.match(/tag:\s*"(.*?)"/)?.[1] || "Salud Bucal";
      const readTime = frontmatterStr.match(/readTime:\s*"(.*?)"/)?.[1] || "5 min de lectura";
      const image = frontmatterStr.match(/image:\s*"(.*?)"/)?.[1] || "";

      return {
        slug,
        title,
        description,
        date,
        author,
        tag,
        readTime,
        image,
        content,
      };
    });
  }
} catch {
  existingPosts = [];
}

const postsJson = JSON.stringify(existingPosts);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel de Administración | Od. Alexis Torres</title>
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- 1. PANTALLA DE LOGIN -->
    <div id="login-view" class="login-wrapper">
      <div class="login-card">
        <div class="login-header">
          <div class="logo-circle">
            <img src="/logo.png" alt="Logo" class="logo-img" />
          </div>
          <h1>Panel Administrativo</h1>
          <p>Gestor de Artículos de Blog · Od. Alexis Torres</p>
        </div>

        <form id="login-form" class="login-body">
          <div id="login-error" class="alert-box error hidden">
            Usuario o contraseña incorrectos.
          </div>

          <div class="form-group">
            <label for="username">Usuario</label>
            <input
              type="text"
              id="username"
              placeholder="ej. usuario.admin"
              autocomplete="username"
              required
            />
          </div>

          <div class="form-group">
            <label for="password">Contraseña</label>
            <input
              type="password"
              id="password"
              placeholder="••••••••••••"
              autocomplete="current-password"
              required
            />
          </div>

          <button type="submit" class="btn btn-primary full-width">
            Iniciar sesión
          </button>
        </form>
      </div>
    </div>

    <!-- 2. DASHBOARD / EDITOR DE BLOG -->
    <div id="dashboard-view" class="dashboard-wrapper hidden">
      <!-- Barra superior -->
      <header class="top-nav">
        <div class="nav-brand">
          <img src="/logo.png" alt="Logo" class="brand-logo" />
          <div>
            <span class="brand-title">Od. Alexis Torres</span>
            <span class="brand-sub">Panel de Publicación y Edición de Blog</span>
          </div>
        </div>

        <div class="nav-actions">
          <button id="new-post-top-btn" type="button" class="btn btn-accent btn-sm">
            + Redactar nueva nota
          </button>
          <a href="/blog" target="_blank" class="btn btn-outline btn-sm">
            Ver blog público ↗
          </a>
          <button id="logout-btn" type="button" class="btn btn-danger btn-sm">
            Cerrar sesión
          </button>
        </div>
      </header>

      <!-- Mensaje de estado / notificación -->
      <div class="dashboard-container">
        <div id="status-toast" class="alert-box success hidden">
          <span id="toast-message">Mensaje de estado</span>
          <button id="close-toast" type="button" class="close-btn">✕</button>
        </div>

        <!-- Layout 2 columnas: Formulario y Vista previa -->
        <div class="admin-grid">
          <!-- Columna principal: Formulario -->
          <div class="admin-col main-col">
            <div class="card">
              <!-- Banner informativo de Modo Edición -->
              <div id="editing-indicator" class="editing-bar hidden">
                <div class="editing-text">
                  <span class="editing-badge">Modo Edición</span>
                  <span>Editando nota: <strong id="editing-title-label">...</strong></span>
                </div>
                <button type="button" id="cancel-edit-btn" class="btn-cancel-edit">
                  ✕ Cancelar y redactar nueva
                </button>
              </div>

              <div class="card-header">
                <h2 id="form-heading">Crear nueva nota de blog</h2>
                <p id="form-subheading" class="subtitle">Escribe la nota y guárdala directamente o descárgala en Markdown (.md).</p>
              </div>

              <form id="post-form" class="editor-form">
                <!-- Título -->
                <div class="form-group">
                  <label for="post-title">Título del artículo *</label>
                  <input
                    type="text"
                    id="post-title"
                    required
                    placeholder="Ej: ¿Cada cuánto tiempo se debe cambiar el cepillo de dientes?"
                  />
                </div>

                <!-- Slug y Categoría -->
                <div class="grid-2">
                  <div class="form-group">
                    <label for="post-slug">Slug (URL amigable) *</label>
                    <input
                      type="text"
                      id="post-slug"
                      required
                      placeholder="cambiar-cepillo-de-dientes"
                    />
                    <small class="help-text">Ruta: /blog/<span id="slug-preview">...</span></small>
                  </div>

                  <div class="form-group">
                    <label for="post-tag">Categoría / Especialidad *</label>
                    <select id="post-tag">
                      <option value="Salud Bucal" selected>Salud Bucal</option>
                      <option value="Prevención">Prevención</option>
                      <option value="Estética Dental">Estética Dental</option>
                      <option value="Ortodoncia">Ortodoncia</option>
                      <option value="Implantes Dentales">Implantes Dentales</option>
                      <option value="Odontopediatría">Odontopediatría</option>
                      <option value="Periodoncia">Periodoncia</option>
                    </select>
                  </div>
                </div>

                <!-- Tiempo, Fecha y Autor -->
                <div class="grid-3">
                  <div class="form-group">
                    <label for="post-readtime">Tiempo de lectura</label>
                    <input type="text" id="post-readtime" value="5 min de lectura" />
                  </div>

                  <div class="form-group">
                    <label for="post-date">Fecha</label>
                    <input type="text" id="post-date" value="03 Mar 2026" />
                  </div>

                  <div class="form-group">
                    <label for="post-author">Autor</label>
                    <input type="text" id="post-author" value="Od. Alexis Torres" />
                  </div>
                </div>

                <!-- Imagen de portada con presets -->
                <div class="form-group">
                  <label for="post-image">URL de imagen de portada</label>
                  <input
                    type="url"
                    id="post-image"
                    value="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=1000&auto=format&fit=crop"
                  />
                  <div class="presets-container">
                    <span class="preset-label">Fotos recomendadas:</span>
                    <button
                      type="button"
                      class="preset-pill"
                      data-img="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=1000&auto=format&fit=crop"
                    >
                      Sonrisa sana
                    </button>
                    <button
                      type="button"
                      class="preset-pill"
                      data-img="https://images.unsplash.com/photo-1609840114035-3c981b782dfe?q=80&w=1000&auto=format&fit=crop"
                    >
                      Revisión clínica
                    </button>
                    <button
                      type="button"
                      class="preset-pill"
                      data-img="https://images.unsplash.com/photo-1629909613654-28e377c37b09?q=80&w=1000&auto=format&fit=crop"
                    >
                      Consultorio
                    </button>
                    <button
                      type="button"
                      class="preset-pill"
                      data-img="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=1000&auto=format&fit=crop"
                    >
                      Paciente feliz
                    </button>
                  </div>
                </div>

                <!-- Resumen SEO -->
                <div class="form-group">
                  <label for="post-description">Resumen corto (meta descripción) *</label>
                  <textarea
                    id="post-description"
                    rows="2"
                    required
                    placeholder="Breve introducción de 1 a 2 párrafos para la tarjeta del blog y Google..."
                  ></textarea>
                </div>

                <!-- Contenido Markdown -->
                <div class="form-group">
                  <div class="markdown-bar-header">
                    <label for="post-content">Contenido del artículo (Markdown) *</label>
                    <div class="toolbar-buttons">
                      <button type="button" class="tool-btn" data-tool="h2">H2</button>
                      <button type="button" class="tool-btn" data-tool="h3">H3</button>
                      <button type="button" class="tool-btn bold" data-tool="bold">B</button>
                      <button type="button" class="tool-btn italic" data-tool="italic">I</button>
                      <button type="button" class="tool-btn" data-tool="quote">" Cita</button>
                      <button type="button" class="tool-btn" data-tool="list">• Lista</button>
                    </div>
                  </div>
                  <textarea
                    id="post-content"
                    rows="13"
                    required
                    placeholder="Escribe aquí el contenido en Markdown...

## Primer subtítulo

Explicación sobre el tema de salud bucodental...

> Consejo del especialista: Acude al dentista cada 6 meses.

### Consejos prácticos:
- Mantén una higiene diaria adecuada
- Usa hilo dental al menos una vez al día
- Evita alimentos con exceso de azúcares"
                  ></textarea>
                </div>

                <!-- Botones de Acción -->
                <div class="actions-row">
                  <button type="submit" id="submit-post-btn" class="btn btn-primary">
                    Guardar y publicar nota
                  </button>

                  <button type="button" id="download-md-btn" class="btn btn-secondary">
                    Descargar archivo .md
                  </button>

                  <button type="button" id="copy-md-btn" class="btn btn-ghost">
                    Copiar Markdown
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- Columna lateral: Vista previa y artículos publicados -->
          <div class="admin-col side-col">
            <!-- Tarjeta Preview -->
            <div class="card preview-card">
              <div class="card-header compact">
                <h3>Vista previa en tiempo real</h3>
                <span class="preview-badge">Live</span>
              </div>

              <div class="preview-article">
                <div class="preview-img-box">
                  <img
                    id="preview-image"
                    src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?q=80&w=1000&auto=format&fit=crop"
                    alt="Preview"
                  />
                  <span id="preview-tag" class="preview-tag-pill">Salud Bucal</span>
                </div>

                <div class="preview-info">
                  <p id="preview-meta" class="preview-meta-text">
                    03 Mar 2026 · 5 min de lectura · Por Od. Alexis Torres
                  </p>
                  <h4 id="preview-title">Título del artículo</h4>
                  <p id="preview-desc">Resumen del artículo...</p>
                </div>

                <div class="preview-body-divider">
                  <span class="preview-body-label">Texto del artículo:</span>
                  <div id="preview-body" class="preview-rendered-body">
                    <em>El texto formateado aparecerá aquí mientras escribes...</em>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tarjeta Artículos Existentes con botón de EDITAR -->
            <div class="card">
              <div class="card-header compact">
                <div>
                  <h3>Artículos en el blog ({existingPosts.length})</h3>
                  <small style="color:#64748b;font-size:0.75rem;">Haz clic en <strong>«Editar ✎»</strong> para modificar una nota</small>
                </div>
                <a href="/blog" target="_blank" class="link-sm">Ver todos ↗</a>
              </div>

              <div class="existing-posts-list">
                {existingPosts.map((p) => (
                  <div class="post-item" data-item-slug={p.slug}>
                    <div class="post-info">
                      <span class="post-tag">{p.tag}</span>
                      <strong class="post-title" title={p.title}>{p.title}</strong>
                      <span class="post-date">{p.date}</span>
                    </div>
                    <div class="post-buttons">
                      <button
                        type="button"
                        class="btn-edit"
                        data-edit-slug={p.slug}
                        title="Cargar nota para editar"
                      >
                        Editar ✎
                      </button>
                      <a
                        href={`/blog/${p.slug}`}
                        target="_blank"
                        class="btn-visit"
                        title="Ver nota pública"
                      >
                        Ver ↗
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- JSON embebido con los datos completos de los posts para edición instantánea -->
    <script id="posts-data-json" type="application/json" set:html={postsJson} />

    <!-- ESTILOS COMPLETOS, SENCILLOS Y ROBUSTOS -->
    <style>
