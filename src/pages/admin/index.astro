        font-size: 1.0625rem;
        font-weight: 700;
        color: var(--color-text-main);
      }

      .subtitle {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        margin-top: 0.25rem;
      }

      /* 4. FORMULARIO & INPUTS */
