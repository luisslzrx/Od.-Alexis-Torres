        padding: 0;
      }

      body {
        font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.5;
      }

      .hidden {
        display: none !important;
      }

      /* 1. LOGIN */
      .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background: linear-gradient(135deg, #0D214B 0%, #1e293b 100%);
      }

      .login-card {
