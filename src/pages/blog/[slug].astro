---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = import.meta.glob("../../content/blog/*.md", { eager: true });
  return Object.entries(posts).map(([path, post]: [string, any]) => {
    const slug = path.split("/").pop()?.replace(".md", "");
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content, frontmatter } = post;

// Obtener otros artículos para la sección de recomendaciones
const allPosts = import.meta.glob("../../content/blog/*.md", { eager: true });
const relatedPosts = Object.entries(allPosts)
  .map(([path, p]: [string, any]) => ({
    slug: path.split("/").pop()?.replace(".md", ""),
    ...p.frontmatter,
  }))
  .filter((p) => p.slug !== slug)
  .slice(0, 2);
---

<Layout
  title={`${frontmatter.title} | Od. Alexis Torres`}
  description={frontmatter.description || "Artículo del blog del Odontólogo Alexis Torres en Xalapa, Ver."}
>
  <article class="w-full bg-white pt-32 pb-24 md:pt-36 md:pb-32">
    <!-- Header del post -->
    <header class="mx-auto max-w-4xl px-6 md:px-10">
      <!-- Navegación de regreso -->
      <a
        href="/#blog"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[#0D214B] hover:text-[#4E8C41] transition-colors mb-8 group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          class="h-4 w-4 transition-transform group-hover:-translate-x-1"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Volver al blog
      </a>

      <!-- Categoría y fecha -->
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-[#4E8C41]/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-[#4E8C41] border border-[#4E8C41]/25">
          {frontmatter.tag}
        </span>
        <span class="text-xs text-slate-400 font-medium">·</span>
        <span class="text-xs font-medium text-slate-500">
          {frontmatter.date}
        </span>
        <span class="text-xs text-slate-400 font-medium">·</span>
        <span class="text-xs font-medium text-slate-500">
          {frontmatter.readTime}
        </span>
      </div>

      <!-- Título principal -->
      <h1 class="mt-6 text-3xl font-bold leading-[1.2] text-slate-900 sm:text-4xl md:text-5xl">
        {frontmatter.title}
      </h1>

      <!-- Autor -->
      <div class="mt-8 flex items-center gap-4 border-y border-slate-100 py-5">
        <img
          src={frontmatter.avatar || "/logo.png"}
          alt={frontmatter.author}
          class="h-12 w-12 rounded-full object-contain bg-slate-50 border border-slate-200 p-1"
        />
        <div>
          <p class="text-base font-semibold text-slate-900">
            {frontmatter.author}
          </p>
          <p class="text-xs text-slate-500">Odontólogo · Xalapa, Ver.</p>
        </div>
      </div>
    </header>

    <!-- Imagen destacada -->
    <div class="mx-auto mt-10 max-w-5xl px-6 md:px-10">
      <div class="overflow-hidden rounded-3xl shadow-lg border border-slate-100">
        <img
          src={frontmatter.image}
          alt={frontmatter.title}
          class="h-[340px] sm:h-[420px] md:h-[500px] w-full object-cover"
        />
      </div>
    </div>

    <!-- Contenido del artículo en Markdown -->
    <div class="mx-auto max-w-3xl px-6 pt-12 md:px-10">
      <div class="blog-content leading-relaxed text-slate-700">
        <Content />
      </div>

      <!-- Caja de llamada a la acción del autor -->
      <div class="mt-16 rounded-3xl bg-[#0D214B] p-8 sm:p-10 text-white shadow-xl">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <span class="inline-block rounded-full bg-[#4E8C41]/25 px-3.5 py-1 text-xs font-semibold text-white mb-3 border border-[#4E8C41]/40">
              Atención personalizada
            </span>
            <h3 class="text-2xl font-bold text-white">¿Tienes dudas o necesitas valoración?</h3>
            <p class="mt-2 text-sm text-slate-300 max-w-md">
              Agenda tu consulta con el Odontólogo Alexis Torres en Xalapa, Ver. Cuidamos cada detalle de tu salud bucal.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
            <a
              href="/#formulario"
              class="inline-flex items-center justify-center rounded-full bg-[#4E8C41] px-6 py-3 text-sm font-semibold text-white shadow-sm transition-transform hover:scale-105 active:scale-95 hover:bg-[#437b38]"
            >
              Agendar cita
            </a>
            <a
              href="https://wa.me/522223085239?text=Hola%2C%20le%C3%AD%20su%20art%C3%ADculo%20del%20blog%20y%20quisiera%20agendar%20una%20cita."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-colors"
            >
              WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Otros artículos recomendados -->
      {relatedPosts.length > 0 && (
        <div class="mt-20 border-t border-slate-200 pt-14">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-bold text-slate-900">Más artículos de interés</h2>
            <a href="/blog" class="text-sm font-semibold text-[#0D214B] hover:text-[#4E8C41] transition-colors">
              Ver todos →
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {relatedPosts.map((relPost) => (
              <a
                href={`/blog/${relPost.slug}`}
                class="group rounded-2xl bg-slate-50 border border-slate-100 p-4 transition-all hover:shadow-md hover:bg-white flex flex-col"
              >
                <div class="overflow-hidden rounded-xl h-44 w-full mb-4">
                  <img
                    src={relPost.image}
                    alt={relPost.title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <span class="text-xs font-bold text-[#4E8C41] uppercase tracking-wider mb-2">
                  {relPost.tag}
                </span>
                <h3 class="text-base font-bold text-slate-900 leading-snug group-hover:text-[#4E8C41] transition-colors line-clamp-2">
                  {relPost.title}
                </h3>
                <span class="mt-auto pt-4 text-xs text-slate-500 font-medium">
                  {relPost.readTime}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>

<style>
  /* Estilos específicos para la tipografía del contenido Markdown */
  .blog-content :global(h2) {
    font-size: 1.65rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .blog-content :global(h3) {
    font-size: 1.3rem;
    font-weight: 600;
    color: #1e293b;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .blog-content :global(p) {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: #334155;
    margin-bottom: 1.25rem;
  }

  .blog-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-content :global(li) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #334155;
    margin-bottom: 0.5rem;
  }

  .blog-content :global(blockquote) {
    border-left: 4px solid #4E8C41;
    padding: 1rem 1.25rem;
    background-color: #f4f8f3;
    border-radius: 0 1rem 1rem 0;
    margin: 1.75rem 0;
    font-style: italic;
    color: #2e5c26;
  }

  .blog-content :global(strong) {
    color: #0f172a;
    font-weight: 600;
  }

  .blog-content :global(hr) {
    border: 0;
    border-top: 1px solid #e2e8f0;
    margin: 2.5rem 0;
  }
</style>
