---
import Layout from "../../layouts/Layout.astro";

const rawPosts = import.meta.glob("../../content/blog/*.md", { eager: true });
const posts = Object.entries(rawPosts).map(([path, post]: [string, any]) => {
  const slug = path.split("/").pop()?.replace(".md", "");
  return {
    slug,
    ...post.frontmatter,
  };
});
---

<Layout
  title="Blog de Salud Bucal y Estética Dental | Od. Alexis Torres"
  description="Consejos, recomendaciones y guías de salud oral escritas por el Odontólogo Alexis Torres en Xalapa, Ver."
>
  <div class="w-full bg-slate-50 pt-32 pb-24 md:pt-36 md:pb-32 min-h-screen">
    <div class="mx-auto max-w-7xl px-6 md:px-14">
      <!-- Breadcrumb / Volver -->
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-[#0D214B] hover:text-[#4E8C41] transition-colors mb-8 group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          class="h-4 w-4 transition-transform group-hover:-translate-x-1"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Volver al inicio
      </a>

      <!-- Header del archivo de blog -->
      <div class="flex flex-col gap-6 max-w-3xl">
        <span class="inline-block w-fit rounded-full border border-slate-300 bg-white px-6 py-2.5 text-sm font-medium text-[#0D214B] shadow-xs">
          Artículos y Noticias
        </span>
        <h1 class="text-4xl font-bold leading-[1.15] text-slate-900 md:text-6xl">
          Blog de Odontología y Cuidado Dental
        </h1>
        <p class="text-base sm:text-lg leading-relaxed text-slate-600">
          Información clara, basada en evidencia y redactada por el <strong>Od. Alexis Torres</strong> para ayudarte a tomar las mejores decisiones sobre tu salud bucodental.
        </p>
      </div>

      <!-- Grid de notas de blog -->
      <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="flex flex-col rounded-3xl bg-white p-4 shadow-sm hover:shadow-md transition-all border border-slate-100 group">
            <div class="relative overflow-hidden rounded-2xl h-60 w-full">
              <img
                src={post.image}
                alt={post.title}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span class="absolute left-4 top-4 rounded-full bg-white/95 backdrop-blur-sm px-4 py-1.5 text-xs font-semibold text-[#0D214B] shadow-sm">
                {post.tag}
              </span>
            </div>

            <div class="flex flex-1 flex-col px-2 pt-6 pb-2">
              <div class="flex items-center justify-between text-xs text-slate-500 mb-4">
                <span class="font-medium text-slate-700">{post.author}</span>
                <span>{post.date} · {post.readTime}</span>
              </div>

              <h2 class="text-xl font-bold leading-snug text-slate-900 group-hover:text-[#4E8C41] transition-colors line-clamp-2">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h2>

              <p class="mt-3 text-sm text-slate-500 leading-relaxed line-clamp-3">
                {post.description}
              </p>

              <div class="mt-auto pt-6 border-t border-slate-100">
                <a
                  href={`/blog/${post.slug}`}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-[#0D214B] group-hover:text-[#4E8C41] transition-colors"
                >
                  Leer artículo completo
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-4 w-4 transition-transform group-hover:translate-x-1"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Banner de contacto / CTA -->
      <div class="mt-20 rounded-3xl bg-[#0D214B] p-8 sm:p-12 text-white shadow-xl text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <h2 class="text-3xl font-bold">¿Tienes dudas sobre tu salud bucal?</h2>
          <p class="mt-2 text-slate-300 text-base max-w-xl">
            Visítanos en Xalapa, Ver. Agenda tu consulta de diagnóstico y recibe un plan de tratamiento totalmente a tu medida.
          </p>
        </div>
        <a
          href="/#formulario"
          class="shrink-0 rounded-full bg-[#4E8C41] px-8 py-3.5 text-base font-semibold text-white shadow-sm transition-transform hover:scale-105 active:scale-95 hover:bg-[#437b38]"
        >
          Agenda tu cita ahora
        </a>
      </div>
    </div>
  </div>
</Layout>
